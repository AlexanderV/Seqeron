<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Enhanced Suffix Array backend (stage S1a: SA-IS + LCP). Managed code only, no native binaries, no P/Invoke.
    Analyzer settings are the same as SuffixTree.Persistent. The reference kernels are safe code; unsafe kernels
    arrive in the optimization iterations (docs/refactoring/suffix-tree-upgrade/PROGRESS-S1.md, 1o.1).
  -->

  <ItemGroup>
    <ProjectReference Include="..\SuffixTree.Core\SuffixTree.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuffixTree.Esa.Tests" />
    <InternalsVisibleTo Include="SuffixTree.Esa.Bench" />
  </ItemGroup>

</Project>
