    <ProjectReference Include="..\..\Algorithms\Seqeron.Genomics.Emboss.Repeats\Seqeron.Genomics.Emboss.Repeats.csproj" />
    <ProjectReference Include="..\Seqeron.Mcp.EmbossSequenceFormats\Seqeron.Mcp.EmbossSequenceFormats.csproj" />
    <ProjectReference Include="..\Seqeron.Mcp.EmbossFeatureTools\Seqeron.Mcp.EmbossFeatureTools.csproj" />
    <ProjectReference Include="..\Seqeron.Mcp.Analysis\Seqeron.Mcp.Analysis.csproj" />
    <ProjectReference Include="..\Seqeron.Mcp.Alignment\Seqeron.Mcp.Alignment.csproj" />
  </ItemGroup>

  <ItemGroup>
