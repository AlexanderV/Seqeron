<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copyleft assembly (GPL-2.0-or-later); NOT part of the MIT-licensed Seqeron assemblies.
       Licence text: LICENSE in this directory; inventory: docs/Validation/review-2026-09/LICENSES.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Seqeron.Genomics.Emboss.SequenceFormats</RootNamespace>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <Description>Port of the EMBOSS 6.6.0 sequence, feature, report and alignment file-format libraries (AJAX / NUCLEUS: sequence readers and writers, feature tables, USA, ACD, databases, report and alignment writers) and the sequence programs (seqret, union, entret, ...). Licensed under GPL-2.0-or-later (the library files LGPL-2.1-or-later).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seqeron.Genomics.Infrastructure\Seqeron.Genomics.Infrastructure.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Core\Seqeron.Genomics.Core.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.IO\Seqeron.Genomics.IO.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Alignment\Seqeron.Genomics.Alignment.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Analysis\Seqeron.Genomics.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Seqeron.Genomics.Core" />
    <Using Include="Seqeron.Genomics.Infrastructure" />
    <Using Include="Seqeron.Genomics.IO" />
    <Using Include="Seqeron.Genomics.Alignment" />
    <Using Include="Seqeron.Genomics.Analysis" />
    <Using Include="Seqeron.Genomics.Emboss.SequenceFormats" />
  </ItemGroup>

  <ItemGroup>
    <!-- B09 WP67 (F309): the data files of the EMBOSS 6.6.0 installation that the data resource catalogue needs (DRCAT.dat, EDAM.obo, emboss.standard) -->
    <EmbeddedResource Include="Data\*.gz" LogicalName="Seqeron.Genomics.Emboss.SequenceFormats.Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Seqeron.Genomics.Emboss.SequenceFormats.Tests" />
  </ItemGroup>

</Project>
