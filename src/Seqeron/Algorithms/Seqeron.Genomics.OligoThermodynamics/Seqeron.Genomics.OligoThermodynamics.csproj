  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Seqeron.Genomics.OligoThermodynamics</RootNamespace>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <Description>Port of the Primer3 ntthal thermodynamic alignment (thal.c: hairpins, homo- and heterodimers, end stability) and the Primer3-style primer / probe design that screens with it. Licensed under GPL-2.0-or-later.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seqeron.Genomics.Infrastructure\Seqeron.Genomics.Infrastructure.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Core\Seqeron.Genomics.Core.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Analysis\Seqeron.Genomics.Analysis.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Alignment\Seqeron.Genomics.Alignment.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.MolTools\Seqeron.Genomics.MolTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Seqeron.Genomics.Infrastructure" />
    <Using Include="Seqeron.Genomics.Core" />
    <Using Include="Seqeron.Genomics.Analysis" />
    <Using Include="Seqeron.Genomics.Alignment" />
    <Using Include="Seqeron.Genomics.MolTools" />
    <Using Include="Seqeron.Genomics.MolTools.PrimerDesigner" Static="true" />
    <Using Include="Seqeron.Genomics.MolTools.ProbeDesigner" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Seqeron.Genomics.OligoThermodynamics.Tests" />
  </ItemGroup>

</Project>
