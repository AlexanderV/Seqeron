<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Seqeron.Genomics.Alignment</RootNamespace>
    <!-- The ksw2 / minimap2 ports emulate the 16-lane SSE code lane by lane: unoptimized Debug code is ~4x slower on the oracle tests (several thousand alignments). -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SuffixTree\Algorithms\SuffixTree\SuffixTree.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Infrastructure\Seqeron.Genomics.Infrastructure.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Core\Seqeron.Genomics.Core.csproj" />
    <ProjectReference Include="..\Seqeron.Genomics.Phylogenetics\Seqeron.Genomics.Phylogenetics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Seqeron.Genomics.Core" />
    <Using Include="Seqeron.Genomics.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Seqeron.Genomics.Tests" />
    <InternalsVisibleTo Include="Seqeron.Genomics.Analysis" />
  </ItemGroup>

</Project>
