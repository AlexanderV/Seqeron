<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dumps the metadata of every [McpServerTool] of the built MCP server assemblies (name, description, parameters with type / default / description) as JSON.
       Used by scripts/docs/sync_mcp_tool_docs.py (audit A5-5); it loads the assemblies by path and references nothing, so it does not take part in Seqeron.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
