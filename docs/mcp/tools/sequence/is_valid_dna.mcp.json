{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "is_valid_dna",
  "serverName": "Sequence",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceExtensions.IsValidDna",
  "docRef": "Seqeron.Genomics/SequenceExtensions.cs#L474",
  "description": "Quick check if a sequence contains only valid DNA characters (A, T, G, C; case-insensitive); iupac=true also accepts the IUPAC ambiguity codes R, Y, S, W, K, M, B, D, H, V, N. Faster than dna_validate but returns less information. Empty input is rejected.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "The sequence to validate",
        "minLength": 1
      },
      "iupac": {
        "type": "boolean",
        "description": "Also accept IUPAC ambiguity codes R, Y, S, W, K, M, B, D, H, V, N (U, X and gaps still invalid). Default false = strict.",
        "default": false
      }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "isValid": { "type": "boolean", "description": "True if all characters are valid DNA" },
      "length": { "type": "integer", "description": "Sequence length" }
    },
    "required": ["isValid", "length"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" }
  ],
  "examples": [
    {
      "name": "Valid DNA",
      "input": { "sequence": "ATGCGATCG" },
      "output": { "isValid": true, "length": 9 }
    },
    {
      "name": "Invalid DNA (contains U)",
      "input": { "sequence": "AUGC" },
      "output": { "isValid": false, "length": 4 }
    },
    {
      "name": "IUPAC-ambiguous DNA (iupac=true)",
      "input": { "sequence": "ACGTRYN", "iupac": true },
      "output": { "isValid": true, "length": 7 }
    }
  ]
}
