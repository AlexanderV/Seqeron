{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "rna_validate",
  "serverName": "Sequence",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RnaSequence.TryCreate",
  "docRef": "Seqeron.Genomics/RnaSequence.cs#L176",
  "description": "Validate an RNA sequence. Returns whether the sequence contains only valid nucleotides (A, C, G, U; case-insensitive). With iupac=true the 11 IUPAC ambiguity codes R, Y, S, W, K, M, B, D, H, V, N are also accepted (Biopython ambiguous_rna_letters). Empty input is rejected.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "The RNA sequence to validate",
        "minLength": 1
      },
      "iupac": {
        "type": "boolean",
        "description": "Also accept IUPAC ambiguity codes R, Y, S, W, K, M, B, D, H, V, N (T, X and gaps still invalid). Default false = strict A/C/G/U.",
        "default": false
      }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean",
        "description": "Whether the sequence is valid RNA"
      },
      "length": {
        "type": "integer",
        "description": "Length of the sequence"
      },
      "error": {
        "type": "string",
        "description": "Error message if invalid (null if valid)"
      }
    },
    "required": ["valid", "length"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" }
  ],
  "examples": [
    {
      "name": "Valid RNA",
      "input": { "sequence": "AUGCAUGC" },
      "output": { "valid": true, "length": 8, "error": null }
    },
    {
      "name": "Invalid RNA (contains T)",
      "input": { "sequence": "AUGTATGC" },
      "output": { "valid": false, "length": 8, "error": "Invalid nucleotide 'T' at position 3" }
    },
    {
      "name": "IUPAC-ambiguous RNA (iupac=true)",
      "input": { "sequence": "ACGURYN", "iupac": true },
      "output": { "valid": true, "length": 7, "error": null }
    }
  ]
}
