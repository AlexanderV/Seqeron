{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "complexity_compression_ratio",
  "serverName": "Sequence",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceComplexity.EstimateCompressionRatio",
  "docRef": "Seqeron.Genomics.Analysis/SequenceComplexity.cs#L1631",
  "description": "Estimate sequence complexity using compression ratio. Lower ratios indicate more repetitive/less complex sequences.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "The sequence to analyze",
        "minLength": 1
      }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "compressionRatio": { "type": "number", "description": "Normalized Lempel-Ziv complexity (>= 0; ~1 for random sequences, may exceed 1)" }
    },
    "required": ["compressionRatio"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" }
  ],
  "examples": [
    {
      "name": "Complex sequence",
      "input": { "sequence": "ATGCGATCGATCG" },
      "output": { "compressionRatio": 0.9962722318072171 }
    },
    {
      "name": "Repetitive sequence",
      "input": { "sequence": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" },
      "output": { "compressionRatio": 0.26609640474436813 }
    }
  ]
}
