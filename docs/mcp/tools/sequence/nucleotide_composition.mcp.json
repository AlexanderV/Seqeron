{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "nucleotide_composition",
  "serverName": "Sequence",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceStatistics.CalculateNucleotideComposition",
  "docRef": "Seqeron.Genomics.Analysis/SequenceStatistics.cs#L60",
  "description": "Calculate nucleotide composition (A, T, G, C, U, N counts; every other character in 'other') and GC content of a DNA/RNA sequence.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "The DNA or RNA sequence to analyze",
        "minLength": 1
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "length": {
        "type": "integer",
        "description": "Total sequence length"
      },
      "a": {
        "type": "integer",
        "description": "Count of adenine"
      },
      "t": {
        "type": "integer",
        "description": "Count of thymine"
      },
      "g": {
        "type": "integer",
        "description": "Count of guanine"
      },
      "c": {
        "type": "integer",
        "description": "Count of cytosine"
      },
      "u": {
        "type": "integer",
        "description": "Count of uracil (RNA)"
      },
      "other": {
        "type": "integer",
        "description": "Count of other characters"
      },
      "gcContent": {
        "type": "number",
        "description": "GC content ratio (0-1)"
      },
      "n": {
        "type": "integer",
        "description": "Count of N (any base); not included in other"
      }
    },
    "required": [
      "length",
      "a",
      "t",
      "g",
      "c",
      "u",
      "other",
      "gcContent",
      "n"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    }
  ],
  "examples": [
    {
      "name": "DNA composition",
      "input": {
        "sequence": "ATGCATGC"
      },
      "output": {
        "length": 8,
        "a": 2,
        "t": 2,
        "g": 2,
        "c": 2,
        "u": 0,
        "other": 0,
        "gcContent": 0.5,
        "n": 0
      }
    },
    {
      "name": "Sequence with N",
      "input": {
        "sequence": "ATGCNN"
      },
      "output": {
        "length": 6,
        "a": 1,
        "t": 1,
        "g": 1,
        "c": 1,
        "u": 0,
        "other": 0,
        "gcContent": 0.5,
        "n": 2
      }
    }
  ]
}
