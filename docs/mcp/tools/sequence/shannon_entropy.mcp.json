{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "shannon_entropy",
  "serverName": "Sequence",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceStatistics.CalculateShannonEntropy",
  "docRef": "Seqeron.Genomics.Analysis/SequenceStatistics.cs#L1578",
  "description": "Shannon entropy H = -sum p_i log2 p_i (bits per symbol) of the per-letter composition. Alphabet: every letter (case-folded) is its own symbol, so DNA, RNA and protein all work; N and IUPAC codes count as distinct symbols, T and U are not merged, and non-letters (gaps, digits, '*', whitespace) are ignored. Max log2(m) for m distinct letters (2 bits for A/C/G/T); 0 for a homopolymer.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "The sequence to analyze",
        "minLength": 1
      }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "entropy": { "type": "number", "description": "Shannon entropy value (bits per symbol)" }
    },
    "required": ["entropy"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" }
  ],
  "examples": [
    {
      "name": "DNA sequence entropy",
      "input": { "sequence": "ATGCATGCAT" },
      "output": { "entropy": 1.9709505944546686 }
    },
    {
      "name": "Low complexity sequence",
      "input": { "sequence": "AAAAAAAAAA" },
      "output": { "entropy": 0.0 }
    }
  ]
}
