{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "dna_validate",
  "serverName": "Sequence",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "DnaSequence.TryCreate",
  "docRef": "Seqeron.Genomics/DnaSequence.cs#L115",
  "description": "Validate a DNA sequence. Returns whether the sequence contains only valid nucleotides (A, C, G, T; case-insensitive). With iupac=true the 11 IUPAC ambiguity codes R, Y, S, W, K, M, B, D, H, V, N are also accepted (Biopython ambiguous_dna_letters). Empty input is rejected.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "The DNA sequence to validate",
        "minLength": 1
      },
      "iupac": {
        "type": "boolean",
        "description": "Also accept IUPAC ambiguity codes R, Y, S, W, K, M, B, D, H, V, N (U, X and gaps still invalid). Default false = strict A/C/G/T.",
        "default": false
      }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean",
        "description": "Whether the sequence is valid DNA"
      },
      "length": {
        "type": "integer",
        "description": "Length of the sequence"
      },
      "error": {
        "type": "string",
        "description": "Error message if invalid (null if valid)"
      }
    },
    "required": ["valid", "length"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" }
  ],
  "examples": [
    {
      "name": "Valid DNA",
      "input": { "sequence": "ATGCATGC" },
      "output": { "valid": true, "length": 8, "error": null }
    },
    {
      "name": "Invalid DNA",
      "input": { "sequence": "ATGXATGC" },
      "output": { "valid": false, "length": 8, "error": "Invalid nucleotide 'X' at position 3" }
    },
    {
      "name": "IUPAC-ambiguous DNA (iupac=true)",
      "input": { "sequence": "ACGTRYN", "iupac": true },
      "output": { "valid": true, "length": 7, "error": null }
    }
  ]
}
