{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "complexity_dust_score",
  "serverName": "Sequence",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceComplexity.CalculateDustScore",
  "docRef": "Seqeron.Genomics.Analysis/SequenceComplexity.cs#L723",
  "description": "Calculate the DUST low-complexity score (Morgulis et al. 2006; the score thresholded by NCBI dustmasker and lh3/sdust): sum over triplets of c(c-1)/2 divided by (number of triplets - 1). Higher scores indicate lower complexity.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "The DNA sequence to analyze",
        "minLength": 1
      },
      "wordSize": {
        "type": "integer",
        "description": "Word size; must be 3 (DUST is defined for triplets only). Kept for compatibility.",
        "default": 3,
        "enum": [3]
      }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "dustScore": { "type": "number", "description": "DUST score (higher = lower complexity)" },
      "wordSize": { "type": "integer", "description": "Word size used" }
    },
    "required": ["dustScore", "wordSize"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" },
    { "code": 1003, "message": "The DUST score is defined for triplets only (word size 3)" }
  ],
  "examples": [
    {
      "name": "Complex sequence",
      "input": { "sequence": "ATGCGATCGATCG", "wordSize": 3 },
      "output": { "dustScore": 0.4, "wordSize": 3 }
    },
    {
      "name": "Low complexity sequence",
      "input": { "sequence": "AAAAAAAAAAAA", "wordSize": 3 },
      "output": { "dustScore": 5.0, "wordSize": 3 }
    }
  ]
}
