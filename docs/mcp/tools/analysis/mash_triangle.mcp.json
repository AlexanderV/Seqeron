{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "toolName": "mash_triangle",
 "serverName": "Analysis",
 "version": "1.0.0",
 "stability": "stable",
 "methodId": "MashCommands.Triangle",
 "docRef": "Seqeron.Genomics.Analysis/MashCommands.cs",
 "description": "Mash 2.3 'mash triangle': the distance of each input to every other input as a lower-triangular matrix in relaxed Phylip format (a first line with a TAB and the number of inputs, then one line per input: its name and the distances to the inputs before it), or with edgeList = true (-E; implied by a p-value or distance filter) the edge list 'name TAB name TAB distance TAB p-value TAB shared/total' of the pairs that pass maxPValue (-v) and maxDistance (-d). Sketches as mash_dist (a file without a record of at least k symbols is refused). VERIFICATION: 220 / 220 random sets (2 - 6 files, k 4 - 32, sketch size 5 - 2000, -n, -i, -E, -v, -d) equal the installed mash 2.3 byte for byte.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "sequences": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "The input files (FASTA texts), at least two for a matrix."
   },
   "names": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "Names of the inputs as the program prints them (default input1, ...)."
   },
   "k": {
    "type": "integer",
    "description": "k-mer size (-k, 1 - 32, default 21).",
    "default": 21
   },
   "sketchSize": {
    "type": "integer",
    "description": "Sketch size (-s, default 1000).",
    "default": 1000
   },
   "seed": {
    "type": "integer",
    "description": "Hash seed (-S, 0 - 4294967295, default 42).",
    "default": 42
   },
   "noncanonical": {
    "type": "boolean",
    "description": "-n: preserve the strand (no canonical k-mers).",
    "default": false
   },
   "individual": {
    "type": "boolean",
    "description": "-i: sketch individual sequences instead of whole files.",
    "default": false
   },
   "edgeList": {
    "type": "boolean",
    "description": "-E: output the edge list instead of the matrix.",
    "default": false
   },
   "maxPValue": {
    "type": "number",
    "description": "-v: maximum p-value to report in the edge list (0 - 1, default 1).",
    "default": 1.0
   },
   "maxDistance": {
    "type": "number",
    "description": "-d: maximum distance to report in the edge list (0 - 1, default 1).",
    "default": 1.0
   }
  },
  "required": [
   "sequences"
  ]
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "text": {
    "type": "string",
    "description": "The text mash triangle writes."
   }
  },
  "required": [
   "text"
  ]
 },
 "errors": [
  {
   "code": 1001,
   "message": "k must be in 1..32 (mash -k)"
  },
  {
   "code": 1001,
   "message": "seed must be in 0..4294967295 (mash -S)"
  },
  {
   "code": 1001,
   "message": "-v must be in 0..1 (mash)"
  }
 ],
 "examples": [
  {
   "name": "Three genomes",
   "input": {
    "sequences": [
     ">g1 first genome\nGGATCACAGTCTACACTGCTCACTCCAACCCCGGCCCCTGAGTCCGAGGAGAGGGTGCTTCAGAGTATGTATACCACTGGGTAGGATACGGCGGAGGGCACGTCAATACGGTTCAATGCCCTACTGCATGCTCTTGTGGTTCATCTGCAT\nGGAGAGGGTGGGCATGGGTGGGGGTGCTGGCCCGTGATCTGGACCTCCCATCCACAGCTCATTGTACCGAGTGTAGAGAGGGGCTTGTCCTTCCAGATAGCGTTTCTGTTTCGGTGTAGGTGCTAATCGACTATGCTACTGCGGTTAACG\n",
     ">g2 close\\n",
     ">g3 distant\\n"
    ],
    "names": [
     "g1.fa",
     "g2.fa",
     "g3.fa"
    ],
    "k": 9,
    "sketchSize": 50
   },
   "output": {
    "text": "\t3\ng1.fa\ng2.fa\t0.0394246\ng3.fa\t0.212171\t0.359853\n"
   }
  }
 ]
}
