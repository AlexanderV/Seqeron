{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "find_inverted_repeats_scored",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RepeatFinder.FindInvertedRepeatsScored",
  "docRef": "Seqeron.Genomics.Analysis/RepeatFinder.cs#L4066",
  "description": "Finds inverted repeats with EMBOSS einverted (Durbin & Thierry-Mieg 1993; EMBOSS 6.6.0): a local alignment of the sequence against its reverse complement in which a Watson–Crick pair scores +matchScore, any other pair mismatchScore and each gap −gapPenalty. Every repeat whose score reaches threshold is reported in einverted's report order with both alignment rows and the match line. Coordinates are **0-based and inclusive** (einverted prints 1-based); alignment rows use the upper-cased input (einverted prints lower case). Symbols other than A/C/G/T never pair. maxRepeatLength bounds the extent from the start of the repeat to the end of its inverted copy (einverted -maxrepeat; memory O(min(maxRepeatLength, n)²)). Cross-checked against the einverted binary (Evidence REP-INV-001). Use find_inverted_repeats for exact/maximal stems (EMBOSS palindrome).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "DNA sequence (case-insensitive; symbols other than A/C/G/T never pair)",
        "minLength": 1
      },
      "gapPenalty": {
        "type": "integer",
        "description": "Gap penalty (einverted -gap)",
        "minimum": 0,
        "default": 12
      },
      "threshold": {
        "type": "integer",
        "description": "Minimum reported score (einverted -threshold)",
        "minimum": 0,
        "default": 50
      },
      "matchScore": {
        "type": "integer",
        "description": "Score of a Watson-Crick pair (einverted -match)",
        "minimum": 0,
        "default": 3
      },
      "mismatchScore": {
        "type": "integer",
        "description": "Score of any other pair (einverted -mismatch)",
        "maximum": 0,
        "default": -4
      },
      "maxRepeatLength": {
        "type": "integer",
        "description": "Maximum extent of the repeat incl. its inverted copy (einverted -maxrepeat)",
        "minimum": 2,
        "default": 2000
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "leftArmStart": {
              "type": "integer"
            },
            "leftArmEnd": {
              "type": "integer"
            },
            "rightArmStart": {
              "type": "integer"
            },
            "rightArmEnd": {
              "type": "integer"
            },
            "score": {
              "type": "integer"
            },
            "matches": {
              "type": "integer"
            },
            "mismatches": {
              "type": "integer"
            },
            "gaps": {
              "type": "integer"
            },
            "leftArmAlignment": {
              "type": "string"
            },
            "matchLine": {
              "type": "string"
            },
            "rightArmAlignment": {
              "type": "string"
            },
            "leftArmLength": {
              "type": "integer"
            },
            "rightArmLength": {
              "type": "integer"
            },
            "loopLength": {
              "type": "integer"
            },
            "percentMatches": {
              "type": "number"
            }
          },
          "required": [
            "leftArmStart",
            "leftArmEnd",
            "rightArmStart",
            "rightArmEnd",
            "score",
            "matches",
            "mismatches",
            "gaps",
            "leftArmAlignment",
            "matchLine",
            "rightArmAlignment"
          ]
        }
      }
    },
    "required": [
      "items"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1003,
      "message": "gapPenalty, threshold, matchScore must be >= 0; mismatchScore <= 0; maxRepeatLength >= 2"
    }
  ],
  "examples": [
    {
      "name": "einverted defaults on a planted imperfect repeat (\"Score 60: 28/31 (90%) matches, 1 gaps\")",
      "input": {
        "sequence": "CCCAACCCATGCGTACGTTAGCCTAGGATCCATTTTTTTTTGGATACTAGGCAACGTACGCATGGGAAGGG"
      },
      "output": {
        "items": [
          {
            "leftArmStart": 0,
            "leftArmEnd": 31,
            "rightArmStart": 40,
            "rightArmEnd": 70,
            "score": 60,
            "matches": 28,
            "mismatches": 3,
            "gaps": 1,
            "leftArmAlignment": "CCCAACCCATGCGTACGTTAGCCTAGGATCCA",
            "matchLine": "|||  |||||||||||||| |||||| |||||",
            "rightArmAlignment": "GGGAAGGGTACGCATGCAA-CGGATCATAGGT",
            "leftArmLength": 32,
            "rightArmLength": 31,
            "loopLength": 8,
            "percentMatches": 90.3225806451613
          }
        ]
      }
    },
    {
      "name": "einverted -gap 8 -threshold 30 (Score 64 = 84 - 12 - 8)",
      "input": {
        "sequence": "CCCAACCCATGCGTACGTTAGCCTAGGATCCATTTTTTTTTGGATACTAGGCAACGTACGCATGGGAAGGG",
        "gapPenalty": 8,
        "threshold": 30
      },
      "output": {
        "items": [
          {
            "leftArmStart": 0,
            "leftArmEnd": 31,
            "rightArmStart": 40,
            "rightArmEnd": 70,
            "score": 64,
            "matches": 28,
            "mismatches": 3,
            "gaps": 1,
            "leftArmAlignment": "CCCAACCCATGCGTACGTTAGCCTAGGATCCA",
            "matchLine": "|||  |||||||||||||| |||||| |||||",
            "rightArmAlignment": "GGGAAGGGTACGCATGCAA-CGGATCATAGGT",
            "leftArmLength": 32,
            "rightArmLength": 31,
            "loopLength": 8,
            "percentMatches": 90.3225806451613
          }
        ]
      }
    },
    {
      "name": "No repeat above threshold",
      "input": {
        "sequence": "ACGTACGTAC"
      },
      "output": {
        "items": []
      }
    }
  ]
}
