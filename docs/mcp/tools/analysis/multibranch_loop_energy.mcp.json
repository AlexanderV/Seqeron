{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "multibranch_loop_energy",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RnaSecondaryStructure.CalculateMultibranchLoopEnergy",
  "docRef": "Seqeron.Genomics.Analysis/RnaSecondaryStructure.cs",
  "description": "Multibranch-loop free energy (kcal/mol). Default: linear Turner 2004 DP model 9.3 + 0*unpaired - 0.9*helices (+ stacking), the MFE engine's model. With unpairedBetweenHelices: NNDB efn2 model 9.25 + 0.91*min(2, average asymmetry) - 0.63*helices + 3.14 strain (3-way, <2 unpaired) (+ stacking).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "numHelices": {
        "type": "integer",
        "description": "Helices in the loop, the closing helix included",
        "minimum": 3
      },
      "numUnpaired": {
        "type": "integer",
        "description": "Total unpaired nucleotides in the loop",
        "minimum": 0
      },
      "hasStrain": {
        "type": "boolean",
        "default": false,
        "description": "efn2 strain flag; only valid with unpairedBetweenHelices and must match the derived condition"
      },
      "stackingEnergy": {
        "type": "number",
        "default": 0.0
      },
      "unpairedBetweenHelices": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "default": null,
        "description": "efn2 input: unpaired nucleotides between consecutive helices, 5'->3' starting after the closing pair"
      }
    },
    "required": [
      "numHelices",
      "numUnpaired"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "energy": {
        "type": "number",
        "description": "kcal/mol"
      }
    },
    "required": [
      "energy"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Invalid multibranch loop arguments (numHelices < 3, numUnpaired < 0, strain without unpairedBetweenHelices, or inconsistent unpairedBetweenHelices)"
    }
  ],
  "examples": [
    {
      "name": "3-way junction, linear model",
      "input": {
        "numHelices": 3,
        "numUnpaired": 6
      },
      "output": {
        "energy": 6.6
      }
    },
    {
      "name": "NNDB efn2 worked example",
      "input": {
        "numHelices": 4,
        "numUnpaired": 8,
        "unpairedBetweenHelices": [
          2,
          0,
          1,
          5
        ]
      },
      "output": {
        "energy": 8.55
      }
    },
    {
      "name": "Strained 3-way (efn2) + stacking",
      "input": {
        "numHelices": 3,
        "numUnpaired": 1,
        "hasStrain": true,
        "stackingEnergy": -2.0,
        "unpairedBetweenHelices": [
          1,
          0,
          0
        ]
      },
      "output": {
        "energy": 9.11
      }
    }
  ]
}
