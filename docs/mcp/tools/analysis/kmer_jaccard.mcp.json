{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "kmer_jaccard",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "KmerAnalyzer.JaccardSimilarity",
  "docRef": "Seqeron.Genomics.Analysis/KmerAnalyzer.cs#L535",
  "description": "Exact k-mer Jaccard index |A∩B|/|A∪B| of the two distinct k-mer sets (fraction in [0,1]) and the Mash distance -ln(2J/(1+J))/k (Ondov et al. 2016). canonical=true gives Mash/sourmash k-mers.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "seq1": {
        "type": "string",
        "description": "First sequence",
        "minLength": 1
      },
      "seq2": {
        "type": "string",
        "description": "Second sequence",
        "minLength": 1
      },
      "k": {
        "type": "integer",
        "description": "k-mer length",
        "minimum": 1
      },
      "canonical": {
        "type": "boolean",
        "description": "Canonical k-mers min(w, revcomp(w)), non-ACGT windows skipped (mash dist default, sourmash, jellyfish -C)",
        "default": false
      },
      "acgtOnly": {
        "type": "boolean",
        "description": "Skip k-mers containing a non-ACGT symbol (mash sketch -n)",
        "default": false
      }
    },
    "required": [
      "seq1",
      "seq2",
      "k"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "jaccard": {
        "type": "number",
        "description": "Jaccard index in [0,1]; 0 when both k-mer sets are empty"
      },
      "mashDistance": {
        "type": "number",
        "description": "Mash distance in [0,1] (0 for identical sets, 1 when no k-mer is shared, capped at 1)"
      }
    },
    "required": [
      "jaccard",
      "mashDistance"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1003,
      "message": "k must be positive"
    }
  ],
  "examples": [
    {
      "name": "Canonical (Mash) k=2",
      "input": {
        "seq1": "ACGTTGCAACGGT",
        "seq2": "ACGTAGCATCGGTA",
        "k": 2,
        "canonical": true
      },
      "output": {
        "jaccard": 0.5,
        "mashDistance": 0.20273255405408222
      }
    },
    {
      "name": "Literal k=3 (Zielezinski Fig. 1)",
      "input": {
        "seq1": "ATGTGTG",
        "seq2": "CATGTG",
        "k": 3
      },
      "output": {
        "jaccard": 0.75,
        "mashDistance": 0.05138355994241945
      }
    }
  ]
}
