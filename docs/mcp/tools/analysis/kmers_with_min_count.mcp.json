{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "kmers_with_min_count",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "KmerAnalyzer.FindKmersWithMinCount",
  "docRef": "Seqeron.Genomics.Analysis/KmerAnalyzer.cs#L2630",
  "description": "Returns k-mers whose overlapping occurrence count is at least minCount and, if given, at most maxCount (jellyfish dump -L/-U), ordered by count descending then k-mer (ordinal). Optional Jellyfish modes: canonical (count -C) and acgtOnly.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": { "type": "string", "description": "Sequence to analyze", "minLength": 1 },
      "k": { "type": "integer", "description": "k-mer length", "minimum": 1 },
      "minCount": { "type": "integer", "description": "Inclusive minimum occurrence count" },
      "maxCount": { "type": "integer", "description": "Optional inclusive maximum occurrence count; omitted = unbounded", "minimum": 0 },
      "canonical": { "type": "boolean", "description": "Canonical k-mers (jellyfish count -C); implies acgtOnly", "default": false },
      "acgtOnly": { "type": "boolean", "description": "Skip windows containing a symbol other than A/C/G/T (case-insensitive)", "default": false }
    },
    "required": ["sequence", "k", "minCount"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "description": "(k-mer, count) pairs with minCount <= count <= maxCount, ordered by count descending then k-mer",
        "items": {
          "type": "object",
          "properties": {
            "kmer": { "type": "string" },
            "count": { "type": "integer" }
          },
          "required": ["kmer", "count"]
        }
      }
    },
    "required": ["items"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" },
    { "code": 1003, "message": "k must be positive" },
    { "code": 1003, "message": "maxCount must be non-negative" }
  ],
  "examples": [
    {
      "name": "Recurrent trimer (minCount=2)",
      "input": { "sequence": "ATGATG", "k": 3, "minCount": 2 },
      "output": { "items": [ { "kmer": "ATG", "count": 2 } ] }
    },
    {
      "name": "All distinct trimers (minCount=1)",
      "input": { "sequence": "ATGATG", "k": 3, "minCount": 1 },
      "output": { "items": [ { "kmer": "ATG", "count": 2 }, { "kmer": "GAT", "count": 1 }, { "kmer": "TGA", "count": 1 } ] }
    },
    {
      "name": "Count range (maxCount=2)",
      "input": { "sequence": "ACGTTGCATGTCGCATGATGCATGAGAGCT", "k": 4, "minCount": 2, "maxCount": 2 },
      "output": { "items": [ { "kmer": "ATGA", "count": 2 }, { "kmer": "TGCA", "count": 2 } ] }
    },
    {
      "name": "Canonical count range (BA1B sample, k=4, jellyfish count -C + dump -L 2 -U 3; Jellyfish 2.3.1)",
      "input": { "sequence": "ACGTTGCATGTCGCATGATGCATGAGAGCT", "k": 4, "minCount": 2, "maxCount": 3, "canonical": true },
      "output": { "items": [ { "kmer": "CATG", "count": 3 }, { "kmer": "ATGA", "count": 2 }, { "kmer": "TGCA", "count": 2 } ] }
    }
  ]
}
