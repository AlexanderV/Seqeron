{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "kmer_d2_statistics",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "KmerAnalyzer.BackgroundAdjustedD2",
  "docRef": "Seqeron.Genomics.Analysis/KmerAnalyzer.cs#L845",
  "description": "Background-adjusted word-match statistics of two DNA sequences: raw D2* and D2S (Reinert et al. 2009), their dissimilarities d2* and d2S in [0,1] (Song et al. 2014; CAFE D2star/D2shepp), the Markov orders used for each sequence, and each sequence's BIC for orders 0..min(k-1, 10) (Schwarz 1978). ACGT windows only, case-insensitive; k <= 12. Optional bothStrands = CAFE -R.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "seq1": {
        "type": "string",
        "description": "First DNA sequence",
        "minLength": 1
      },
      "seq2": {
        "type": "string",
        "description": "Second DNA sequence",
        "minLength": 1
      },
      "k": {
        "type": "integer",
        "description": "Word length k",
        "minimum": 1,
        "maximum": 12
      },
      "markovOrder": {
        "type": "integer",
        "description": "Background Markov order r (0 <= r < k), or -1 to choose each sequence's order by BIC",
        "minimum": -1,
        "default": 0
      },
      "bothStrands": {
        "type": "boolean",
        "description": "CAFE -R both-strand mode (count of w + count of its reverse complement; background averaged over both)",
        "default": false
      }
    },
    "required": [
      "seq1",
      "seq2",
      "k"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "d2Star": {
        "type": "number",
        "description": "Raw D2* statistic"
      },
      "d2Shepherd": {
        "type": "number",
        "description": "Raw D2S statistic"
      },
      "d2StarDistance": {
        "type": "number",
        "description": "d2* dissimilarity in [0,1] (NaN when undefined)"
      },
      "d2ShepherdDistance": {
        "type": "number",
        "description": "d2S dissimilarity in [0,1] (NaN when undefined)"
      },
      "markovOrder1": {
        "type": "integer",
        "description": "Background order used for seq1"
      },
      "markovOrder2": {
        "type": "integer",
        "description": "Background order used for seq2"
      },
      "bic1": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "description": "BIC of seq1 for orders 0..min(k-1,10) (index = order)"
      },
      "bic2": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "description": "BIC of seq2 for orders 0..min(k-1,10) (index = order)"
      }
    },
    "required": [
      "d2Star",
      "d2Shepherd",
      "d2StarDistance",
      "d2ShepherdDistance",
      "markovOrder1",
      "markovOrder2",
      "bic1",
      "bic2"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "Sequence has no k-mer window over A/C/G/T."
    },
    {
      "code": 1003,
      "message": "K must be in [1, 12]."
    },
    {
      "code": 1003,
      "message": "Markov order must be in [0, k) or -1 (BIC)."
    }
  ],
  "examples": [
    {
      "name": "Order-0 background, single strand",
      "input": {
        "seq1": "AGGTAAGGTGGTTGAGATCTGGACTTTTGACGCCTGGAGCCCGCAGTGCTCCTCGAAAAGTAGCCATGCCTTGGGCTGCT",
        "seq2": "CAAAGGCCCTACCTTCTTATAGTCCTTTCAACATACAAGTATAGTTGGAAGTTCTAAGTTCAGTTTAATC",
        "k": 3
      },
      "output": {
        "d2Star": 7.136981012975184,
        "d2Shepherd": -0.6884013403313263,
        "d2StarDistance": 0.44457941706964565,
        "d2ShepherdDistance": 0.5084031847096179,
        "markovOrder1": 0,
        "markovOrder2": 0,
        "bic1": [
          231.88984329117494,
          255.74056400499072,
          370.90681674887685
        ],
        "bic2": [
          199.825085479026,
          217.12856241056033,
          322.30742386881116
        ]
      }
    }
  ]
}
