{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "gc_content_profile",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceStatistics.CalculateGcContentProfile",
  "docRef": "Seqeron.Genomics.Analysis/SequenceStatistics.cs#L2433",
  "description": "GC content in sliding windows along a nucleotide sequence, as a percentage (default) or a fraction (fraction=true). Default counting (G+C)/(A+C+G+T+U) with other symbols excluded; optional Biopython gc_fraction ambiguityMode (remove|ignore|weighted); optional includePartialWindow scores trailing windows shorter than windowSize (range(0, len, step) slicing).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "Nucleotide sequence",
        "minLength": 1
      },
      "windowSize": {
        "type": "integer",
        "description": "Window size (default 100)",
        "minimum": 1,
        "default": 100
      },
      "stepSize": {
        "type": "integer",
        "description": "Step size (default 1)",
        "minimum": 1,
        "default": 1
      },
      "fraction": {
        "type": "boolean",
        "description": "Report fractions in [0,1] instead of percentages",
        "default": false
      },
      "ambiguityMode": {
        "type": "string",
        "description": "Biopython gc_fraction ambiguous mode (case-insensitive); omit for the default counting",
        "enum": [
          "remove",
          "ignore",
          "weighted"
        ]
      },
      "includePartialWindow": {
        "type": "boolean",
        "description": "Also score the trailing windows shorter than windowSize",
        "default": false
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "values": {
        "type": "array",
        "description": "GC content per window (percentage 0-100, or fraction 0-1 with fraction=true)",
        "items": {
          "type": "number"
        }
      }
    },
    "required": [
      "values"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "Window size must be at least 1"
    },
    {
      "code": 1002,
      "message": "Step size must be at least 1"
    },
    {
      "code": 1003,
      "message": "Unknown ambiguity mode. Expected one of: remove, ignore, weighted."
    }
  ],
  "examples": [
    {
      "name": "GC-rich windows GGCC (window 2, step 1)",
      "input": {
        "sequence": "GGCC",
        "windowSize": 2,
        "stepSize": 1
      },
      "output": {
        "values": [
          100.0,
          100.0,
          100.0
        ]
      }
    },
    {
      "name": "AT-only windows, non-overlapping (window 2, step 2)",
      "input": {
        "sequence": "ATAT",
        "windowSize": 2,
        "stepSize": 2
      },
      "output": {
        "values": [
          0.0,
          0.0
        ]
      }
    },
    {
      "name": "Biopython weighted ambiguity mode (fractions)",
      "input": {
        "sequence": "ACGTSSWWNNRYacgusw",
        "windowSize": 6,
        "stepSize": 3,
        "fraction": true,
        "ambiguityMode": "weighted"
      },
      "output": {
        "values": [
          0.6666666666666666,
          0.4166666666666667,
          0.3333333333333333,
          0.5833333333333334,
          0.5
        ]
      }
    },
    {
      "name": "Trailing partial windows",
      "input": {
        "sequence": "GGGCCCAAATTTGCGCA",
        "windowSize": 6,
        "stepSize": 4,
        "fraction": true,
        "includePartialWindow": true
      },
      "output": {
        "values": [
          1.0,
          0.3333333333333333,
          0.3333333333333333,
          0.8,
          0.0
        ]
      }
    }
  ]
}
