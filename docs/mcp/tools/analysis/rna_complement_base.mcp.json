{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "rna_complement_base",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RnaSecondaryStructure.GetComplement",
  "docRef": "Seqeron.Genomics.Analysis/RnaSecondaryStructure.cs#L449",
  "description": "Returns the RNA complement of a single base, as Biopython complement_rna: A→U, U→A, G↔C, DNA T→A; IUPAC ambiguity codes are complemented (R↔Y, K↔M, B↔V, D↔H; S, W, N unchanged). Case-insensitive, upper-case output for recognized codes; other characters pass through.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "base": { "type": "string", "description": "RNA base (length-1 string)", "minLength": 1, "maxLength": 1 }
    },
    "required": ["base"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "complement": { "type": "string", "description": "Complement base" }
    },
    "required": ["complement"]
  },
  "errors": [
    { "code": 1001, "message": "Expected a single character (length-1 string)" }
  ],
  "examples": [
    {
      "name": "A -> U",
      "input": { "base": "A" },
      "output": { "complement": "U" }
    },
    {
      "name": "G -> C",
      "input": { "base": "G" },
      "output": { "complement": "C" }
    },
    {
      "name": "DNA T -> A",
      "input": { "base": "T" },
      "output": { "complement": "A" }
    },
    {
      "name": "IUPAC R -> Y",
      "input": { "base": "R" },
      "output": { "complement": "Y" }
    }
  ]
}
