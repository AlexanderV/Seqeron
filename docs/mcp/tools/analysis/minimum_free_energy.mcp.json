{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "minimum_free_energy",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RnaSecondaryStructure.CalculateMinimumFreeEnergy",
  "docRef": "Seqeron.Genomics.Analysis/RnaSecondaryStructure.cs#L1020",
  "description": "Zuker-style minimum free energy of an RNA sequence with Turner 2004 parameters (O(n^3)). Returns kcal/mol; 0 when no structure forms.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "rnaSequence": {
        "type": "string",
        "description": "RNA sequence",
        "minLength": 1
      },
      "minLoopSize": {
        "type": "integer",
        "description": "Minimum hairpin loop size (default 3; values <3 are clamped)",
        "default": 3
      },
      "temperature": {
        "type": "number",
        "description": "Absolute temperature in Kelvin (default 310.15 = 37 °C); every Turner 2004 parameter is rescaled with its enthalpy, dG(T) = dH - (dH - dG37)*T/310.15 (ViennaRNA md.temperature)",
        "default": 310.15,
        "exclusiveMinimum": 0
      }
    },
    "required": [
      "rnaSequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "mfe": {
        "type": "number",
        "description": "Minimum free energy in kcal/mol"
      }
    },
    "required": [
      "mfe"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    }
  ],
  "examples": [
    {
      "name": "Simple GC hairpin",
      "input": {
        "rnaSequence": "GGGAAACCC"
      },
      "output": {
        "mfe": -1.12
      }
    },
    {
      "name": "No structure (poly-A)",
      "input": {
        "rnaSequence": "AAAAAAAA"
      },
      "output": {
        "mfe": 0.0
      }
    }
  ]
}
