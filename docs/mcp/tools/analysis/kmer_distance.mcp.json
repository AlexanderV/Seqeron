{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "kmer_distance",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "KmerAnalyzer.KmerDistance",
  "docRef": "Seqeron.Genomics.Analysis/KmerAnalyzer.cs#L392",
  "description": "Alignment-free word-vector distance between two sequences' k-mer composition. Default: Euclidean distance between the normalized k-mer frequency vectors (0 = identical composition). Optional metric: squared_euclidean_counts (Blaisdell d_E), manhattan, chebyshev, canberra (frequencies), cosine, d2 (count inner product, a similarity).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "seq1": {
        "type": "string",
        "description": "First sequence",
        "minLength": 1
      },
      "seq2": {
        "type": "string",
        "description": "Second sequence",
        "minLength": 1
      },
      "k": {
        "type": "integer",
        "description": "k-mer length",
        "minimum": 1
      },
      "metric": {
        "type": "string",
        "description": "Word-vector metric",
        "enum": [
          "euclidean",
          "squared_euclidean_counts",
          "manhattan",
          "chebyshev",
          "canberra",
          "cosine",
          "d2"
        ],
        "default": "euclidean"
      }
    },
    "required": [
      "seq1",
      "seq2",
      "k"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "distance": {
        "type": "number",
        "description": "Metric value (non-negative; for d2 the count inner product)"
      }
    },
    "required": [
      "distance"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1003,
      "message": "k must be positive"
    },
    {
      "code": 1002,
      "message": "metric must be one of: euclidean, squared_euclidean_counts, manhattan, chebyshev, canberra, cosine, d2"
    }
  ],
  "examples": [
    {
      "name": "Identical sequences => 0",
      "input": {
        "seq1": "ACGTACGT",
        "seq2": "ACGTACGT",
        "k": 2
      },
      "output": {
        "distance": 0.0
      }
    },
    {
      "name": "Disjoint monomers => sqrt(2)",
      "input": {
        "seq1": "AAAA",
        "seq2": "TTTT",
        "k": 1
      },
      "output": {
        "distance": 1.4142135623730951
      }
    },
    {
      "name": "Blaisdell squared Euclidean on counts (Zielezinski 2017 Fig. 1) => 3",
      "input": {
        "seq1": "ATGTGTG",
        "seq2": "CATGTG",
        "k": 3,
        "metric": "squared_euclidean_counts"
      },
      "output": {
        "distance": 3.0
      }
    }
  ]
}
