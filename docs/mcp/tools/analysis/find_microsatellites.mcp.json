                "totalLength": 12,
                "repeatType": "Mononucleotide"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "Custom MISA definition with 7-10 bp units + misa.pl scan + compound (misa.pl row c ... 105 1 105)",
      "input": {
        "sequence": "ACGTTGCACGTTGCACGTTGCGAAAAAAAAAAAACCTTAGGCATTAGGCATTAGGCATTCGACGTACGTACGTACGTACGTACGTGGATCCATGCAATCCATGCAATTGCACCTTGAGACCTTGAGANNACCTTGAGAGG",
        "misaScan": true,
        "maxCompoundInterruption": 10,
        "misaDefinition": "1-10 2-6 3-5 4-5 5-5 6-5 7-3 8-3 9-2 10-2"
      },
      "output": {
        "items": [
          {
            "position": 22,
            "repeatUnit": "A",
            "repeatCount": 12,
            "totalLength": 12,
            "repeatType": "Mononucleotide"
          },
          {
            "position": 61,
            "repeatUnit": "ACGT",
            "repeatCount": 6,
            "totalLength": 24,
            "repeatType": "Tetranucleotide"
          },
          {
            "position": 0,
            "repeatUnit": "ACGTTGC",
