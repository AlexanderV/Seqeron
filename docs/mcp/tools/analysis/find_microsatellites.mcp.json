          },
          {
            "position": 87,
            "repeatUnit": "ATCCATGCA",
            "repeatCount": 2,
            "totalLength": 18,
            "repeatType": "Complex"
          }
        ],
        "compounds": [
          {
            "start": 0,
            "end": 105,
            "length": 105,
            "type": "c",
            "notation": "(ACGTTGC)3g(A)12cc(TTAGGCA)3ttcg(ACGT)6gg(ATCCATGCA)2",
            "components": [
              {
                "position": 0,
                "repeatUnit": "ACGTTGC",
                "repeatCount": 3,
                "totalLength": 21,
                "repeatType": "Complex"
              },
              {
                "position": 22,
                "repeatUnit": "A",
