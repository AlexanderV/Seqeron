{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "toolName": "mash_bounds",
 "serverName": "Analysis",
 "version": "1.0.0",
 "stability": "stable",
 "methodId": "MashCommands.Bounds",
 "docRef": "Seqeron.Genomics.Analysis/MashCommands.cs",
 "description": "Mash 2.3 'mash bounds -k K -p P', byte for byte: the table of error bounds of the Mash distance and of the screen distance for the sketch sizes 100 ... 1000000 and the distances 0.05 ... 0.4 (CommandBounds.cpp): for the binomial model of the number of shared hashes the smallest x whose cumulative probability exceeds (1 - p) / 2 gives the lower Jaccard bound, converted back to a distance and printed as the error (bound minus distance; inf when no hash is certain to be shared). The numbers are printed as C++ cout does (6 significant digits). VERIFICATION: 220 / 220 random (k, p) equal the installed mash 2.3.",
 "inputSchema": {
  "type": "object",
  "properties": {
   "k": {
    "type": "integer",
    "description": "k-mer size (1 - 32, default 21).",
    "default": 21
   },
   "probability": {
    "type": "number",
    "description": "Confidence of the bounds (0 - 1 exclusive, default 0.99).",
    "default": 0.99
   }
  }
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "text": {
    "type": "string",
    "description": "The text mash bounds writes."
   }
  },
  "required": [
   "text"
  ]
 },
 "errors": [
  {
   "code": 1001,
   "message": "k must be in 1..32 (mash -k)"
  },
  {
   "code": 1001,
   "message": "seed must be in 0..4294967295 (mash -S)"
  },
  {
   "code": 1001,
   "message": "-v must be in 0..1 (mash)"
  }
 ],
 "examples": [
  {
   "name": "Default parameters",
   "input": {
    "k": 21,
    "probability": 0.99
   },
   "output": {
