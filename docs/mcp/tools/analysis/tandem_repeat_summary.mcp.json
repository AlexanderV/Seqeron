{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "tandem_repeat_summary",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RepeatFinder.GetTandemRepeatSummary",
  "docRef": "Seqeron.Genomics.Analysis/RepeatFinder.cs#L3376",
  "description": "Aggregate statistics across all microsatellites (STRs) in a DNA sequence: total repeats, repeat bases, percent of sequence covered, per-type counts (mono..hexa), longest repeat and most frequent unit. Also the MISA table of repeat-type classes considering sequence complementarity (motif rotations + reverse complement, e.g. AC/CA/GT/TG -> AC/GT); optional MISA per-unit-size thresholds.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "DNA sequence",
        "minLength": 1
      },
      "minRepeats": {
        "type": "integer",
        "description": "Minimum repeats (default 3); ignored when misaThresholds is true",
        "minimum": 2,
        "default": 3
      },
      "misaThresholds": {
        "type": "boolean",
        "description": "Use MISA default minimum copies per unit length (1-10 2-6 3-5 4-5 5-5 6-5) instead of minRepeats",
        "default": false
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "totalRepeats": {
        "type": "integer"
      },
      "totalRepeatBases": {
        "type": "integer"
      },
      "percentageOfSequence": {
        "type": "number"
      },
      "mononucleotideRepeats": {
        "type": "integer"
      },
      "dinucleotideRepeats": {
        "type": "integer"
      },
      "trinucleotideRepeats": {
        "type": "integer"
      },
      "tetranucleotideRepeats": {
        "type": "integer"
      },
      "pentanucleotideRepeats": {
        "type": "integer"
      },
      "hexanucleotideRepeats": {
        "type": "integer"
      },
      "longestRepeat": {
        "type": [
          "object",
          "null"
        ]
      },
      "mostFrequentUnit": {
        "type": [
          "string",
          "null"
        ]
      },
      "canonicalMotifCounts": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": {
          "type": "integer"
        },
        "description": "STR count per MISA repeat-type class (e.g. AC/GT)"
      }
    },
    "required": [
      "totalRepeats",
      "totalRepeatBases",
      "percentageOfSequence",
      "mononucleotideRepeats",
      "dinucleotideRepeats",
      "trinucleotideRepeats",
      "tetranucleotideRepeats",
      "pentanucleotideRepeats",
      "hexanucleotideRepeats"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1001,
      "message": "Invalid DNA sequence"
    }
  ],
  "examples": [
    {
      "name": "Single trinucleotide STR",
      "input": {
        "sequence": "CAGCAGCAG",
        "minRepeats": 3
      },
      "output": {
        "totalRepeats": 1,
        "totalRepeatBases": 9,
        "percentageOfSequence": 100.0,
        "mononucleotideRepeats": 0,
        "dinucleotideRepeats": 0,
        "trinucleotideRepeats": 1,
        "tetranucleotideRepeats": 0,
        "pentanucleotideRepeats": 0,
        "hexanucleotideRepeats": 0,
        "longestRepeat": {
          "position": 0,
          "repeatUnit": "CAG",
          "repeatCount": 3,
          "totalLength": 9,
          "repeatType": "Trinucleotide"
        },
        "mostFrequentUnit": "CAG",
        "canonicalMotifCounts": {
          "AGC/CTG": 1
        }
      }
    },
    {
      "name": "No STRs",
      "input": {
        "sequence": "ACGT",
        "minRepeats": 3
      },
      "output": {
        "totalRepeats": 0,
        "totalRepeatBases": 0,
        "percentageOfSequence": 0.0,
        "mononucleotideRepeats": 0,
        "dinucleotideRepeats": 0,
        "trinucleotideRepeats": 0,
        "tetranucleotideRepeats": 0,
        "pentanucleotideRepeats": 0,
        "hexanucleotideRepeats": 0,
        "longestRepeat": null,
        "mostFrequentUnit": null,
        "canonicalMotifCounts": {}
      }
    },
    {
      "name": "Penta + hexa STRs with overlapping homopolymers",
      "input": {
        "sequence": "AAAGAAAAGAAAAGAAAAGACCTTAGGGTTAGGGTTAGGGTTAGGG",
        "minRepeats": 3
      },
      "output": {
        "totalRepeats": 10,
        "totalRepeatBases": 71,
        "percentageOfSequence": 95.65217391304348,
        "mononucleotideRepeats": 8,
        "dinucleotideRepeats": 0,
        "trinucleotideRepeats": 0,
        "tetranucleotideRepeats": 0,
        "pentanucleotideRepeats": 1,
        "hexanucleotideRepeats": 1,
        "longestRepeat": {
          "position": 22,
          "repeatUnit": "TTAGGG",
          "repeatCount": 4,
          "totalLength": 24,
          "repeatType": "Hexanucleotide"
        },
        "mostFrequentUnit": "A",
        "canonicalMotifCounts": {
          "A/T": 4,
          "C/G": 4,
          "AAAAG/CTTTT": 1,
          "AACCCT/AGGGTT": 1
        }
      }
    }
  ]
}
