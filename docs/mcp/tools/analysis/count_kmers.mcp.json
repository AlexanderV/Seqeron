{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "count_kmers",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "KmerAnalyzer.CountKmers",
  "docRef": "Seqeron.Genomics.Analysis/KmerAnalyzer.cs#L20",
  "description": "Counts every overlapping k-mer occurrence in a sequence. Returns k-mer -> count; counts sum to L - k + 1. Optional Jellyfish modes: acgtOnly (skip windows with a non-ACGT symbol) and canonical (jellyfish count -C, key = min(k-mer, reverse complement); implies acgtOnly).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": { "type": "string", "description": "Sequence to analyze", "minLength": 1 },
      "k": { "type": "integer", "description": "k-mer length", "minimum": 1 },
      "canonical": { "type": "boolean", "description": "Canonical counting (jellyfish count -C); implies acgtOnly", "default": false },
      "acgtOnly": { "type": "boolean", "description": "Skip windows containing a symbol other than A/C/G/T (case-insensitive)", "default": false }
    },
    "required": ["sequence", "k"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "counts": {
        "type": "object",
        "description": "Map of k-mer -> occurrence count",
        "additionalProperties": { "type": "integer" }
      }
    },
    "required": ["counts"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" },
    { "code": 1003, "message": "k must be positive" }
  ],
  "examples": [
    {
      "name": "Homopolymer",
      "input": { "sequence": "AAAA", "k": 2 },
      "output": { "counts": { "AA": 3 } }
    },
    {
      "name": "Mixed 3-mers",
      "input": { "sequence": "ATGATG", "k": 3 },
      "output": { "counts": { "ATG": 2, "TGA": 1, "GAT": 1 } }
    },
    {
      "name": "Canonical 3-mers (jellyfish -C)",
      "input": { "sequence": "ATGATG", "k": 3, "canonical": true },
      "output": { "counts": { "ATG": 2, "ATC": 1, "TCA": 1 } }
    },
    {
      "name": "ACGT-only (N resets the window)",
      "input": { "sequence": "ACGTNACGT", "k": 4, "acgtOnly": true },
      "output": { "counts": { "ACGT": 2 } }
    }
  ]
}
