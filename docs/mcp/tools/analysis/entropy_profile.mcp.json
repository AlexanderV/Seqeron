{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "entropy_profile",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceStatistics.CalculateEntropyProfile",
  "docRef": "Seqeron.Genomics.Analysis/SequenceStatistics.cs#L2577",
  "description": "Shannon-entropy profile: per sliding window H = -sum p*log2(p) in bits over letter frequencies (every case-folded letter is its own symbol: N/IUPAC codes distinct, T and U not merged, non-letters ignored) or, with k, over the overlapping k-mers of the window. Optional includePartialWindow scores trailing windows shorter than windowSize. Max is log2(m) for m distinct symbols.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "Sequence to analyze",
        "minLength": 1
      },
      "windowSize": {
        "type": "integer",
        "description": "Window size",
        "minimum": 1,
        "default": 50
      },
      "stepSize": {
        "type": "integer",
        "description": "Step size",
        "minimum": 1,
        "default": 1
      },
      "k": {
        "type": "integer",
        "description": "k-mer length for block entropy; omit for letter entropy",
        "minimum": 1
      },
      "includePartialWindow": {
        "type": "boolean",
        "description": "Also score the trailing windows shorter than windowSize",
        "default": false
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "values": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "description": "Per-window entropy in bits"
      }
    },
    "required": [
      "values"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1003,
      "message": "Window size must be at least 1"
    },
    {
      "code": 1003,
      "message": "Step size must be at least 1"
    },
    {
      "code": 1003,
      "message": "k must be at least 1"
    }
  ],
  "examples": [
    {
      "name": "Homopolymer",
      "input": {
        "sequence": "AAAA",
        "windowSize": 2,
        "stepSize": 1
      },
      "output": {
        "values": [
          0,
          0,
          0
        ]
      }
    },
    {
      "name": "Uniform window",
      "input": {
        "sequence": "ATGC",
        "windowSize": 4
      },
      "output": {
        "values": [
          2.0
        ]
      }
    },
    {
      "name": "k-mer entropy with partial windows",
      "input": {
        "sequence": "ACGTACGTAAAACCCGGT",
        "windowSize": 8,
        "stepSize": 3,
        "k": 2,
        "includePartialWindow": true
      },
      "output": {
        "values": [
          1.950212064914747,
          2.2359263506290326,
          2.128085278891394,
          2.2359263506290326,
          1.9219280948873625,
          1.0
        ]
      }
    }
  ]
}
