{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "analyze_gc_content",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "GcSkewCalculator.AnalyzeGcContent",
  "docRef": "Seqeron.Genomics.Analysis/GcSkewCalculator.cs#L985",
  "description": "Comprehensive GC report: overall GC content, GC/AT skew, content/skew variances, and windowed GC profiles. GC content is a percentage [0,100] by default, or a fraction [0,1] with fraction=true. Optional ambiguity (remove|ignore|weighted) applies Biopython gc_fraction IUPAC handling to the GC content.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "DNA sequence (A/C/G/T)",
        "minLength": 1
      },
      "windowSize": {
        "type": "integer",
        "description": "Sliding-window length for the profiles",
        "default": 1000,
        "minimum": 1
      },
      "stepSize": {
        "type": "integer",
        "description": "Step between window starts",
        "default": 100,
        "minimum": 1
      },
      "fraction": {
        "type": "boolean",
        "description": "Report overall and windowed GC content (and its variance) as a fraction in [0,1] (Biopython gc_fraction) instead of a percentage. Default false.",
        "default": false
      },
      "ambiguity": {
        "type": "string",
        "description": "Biopython gc_fraction ambiguous mode for overall and windowed GC content (case-insensitive): remove (S counts as GC, S/W in denominator, other codes dropped; GGSW -> 0.75), ignore (denominator = length), weighted (codes add mean GC). Allows IUPAC DNA input ACGTRYSWKMBDHVN. Omit for strict A/C/G/T.",
        "enum": ["remove", "ignore", "weighted"]
      }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "overallGcContent": { "type": "number", "description": "GC% over whole sequence = (G+C)/(A+T+G+C)*100 (fraction in [0,1] when fraction=true)" },
      "overallGcSkew": { "type": "number", "description": "GC skew = (G-C)/(G+C) in [-1,1]" },
      "overallAtSkew": { "type": "number", "description": "AT skew = (A-T)/(A+T) in [-1,1]" },
      "gcContentVariance": { "type": "number", "description": "Population variance of per-window GC% (of per-window fractions when fraction=true)" },
      "gcSkewVariance": { "type": "number", "description": "Population variance of per-window GC skew" },
      "windowedGcSkew": {
        "type": "array",
        "description": "Per-window GC-skew points",
        "items": {
          "type": "object",
          "properties": {
            "position": { "type": "integer" },
            "gcSkew": { "type": "number" },
            "windowStart": { "type": "integer" },
            "windowEnd": { "type": "integer" }
          },
          "required": ["position", "gcSkew", "windowStart", "windowEnd"]
        }
      },
      "windowedGcContent": {
        "type": "array",
        "description": "Per-window GC-content points",
        "items": {
          "type": "object",
          "properties": {
            "position": { "type": "integer" },
            "gcContent": { "type": "number" },
            "windowStart": { "type": "integer" },
            "windowEnd": { "type": "integer" }
          },
          "required": ["position", "gcContent", "windowStart", "windowEnd"]
        }
      },
      "sequenceLength": { "type": "integer", "description": "Length of the input sequence" }
    },
    "required": ["overallGcContent", "overallGcSkew", "overallAtSkew", "gcContentVariance", "gcSkewVariance", "windowedGcSkew", "windowedGcContent", "sequenceLength"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" },
    { "code": 1002, "message": "Invalid DNA sequence" },
    { "code": 1001, "message": "Invalid IUPAC DNA symbol '<c>' at position <i> (with ambiguity)" },
    { "code": 1001, "message": "Unknown ambiguity mode '<m>'. Expected one of: remove, ignore, weighted." }
  ],
  "examples": [
    {
      "name": "Overall scalar metrics on GGGCCAT",
      "input": { "sequence": "GGGCCAT" },
      "output": {
        "overallGcContent": 71.42857142857143,
        "overallGcSkew": 0.2,
        "overallAtSkew": 0.0,
        "gcContentVariance": 0.0,
        "gcSkewVariance": 0.0,
        "windowedGcSkew": [],
        "windowedGcContent": [],
        "sequenceLength": 7
      }
    },
    {
      "name": "Windowed population variance on GGCC (window 2, step 2)",
      "input": { "sequence": "GGCC", "windowSize": 2, "stepSize": 2 },
      "output": {
        "overallGcContent": 100.0,
        "overallGcSkew": 0.0,
        "gcSkewVariance": 1.0,
        "gcContentVariance": 0.0,
        "sequenceLength": 4
      }
    },
    {
      "name": "GC content as a fraction (fraction=true) on GGGCCAT (window 4, step 3)",
      "input": { "sequence": "GGGCCAT", "windowSize": 4, "stepSize": 3, "fraction": true },
      "output": {
        "overallGcContent": 0.7142857142857143,
        "overallGcSkew": 0.2,
        "gcContentVariance": 0.0625,
        "gcSkewVariance": 0.5625,
        "sequenceLength": 7
      }
    },
    {
      "name": "IUPAC ambiguity (Biopython gc_fraction remove) on GGSNNBWAACSSWWGCGNAT (window 5, step 3)",
      "input": { "sequence": "GGSNNBWAACSSWWGCGNAT", "windowSize": 5, "stepSize": 3, "fraction": true, "ambiguity": "remove" },
      "output": {
        "overallGcContent": 0.5625,
        "overallGcSkew": 0.3333333333333333,
        "overallAtSkew": 0.5,
        "gcContentVariance": 0.08805555555555555,
        "gcSkewVariance": 0.5061728395061729,
        "sequenceLength": 20
      }
    }
  ]
}
