{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "shared_motifs_significance",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "MotifFinder.FindSharedMotifs",
  "docRef": "Seqeron.Genomics.Analysis/MotifFinder.OligoAnalysis.cs#L140",
  "description": "RSAT `oligo-analysis -return mseq,proba` (the RSAT overload of `MotifFinder.FindSharedMotifs`): for each word (or reverse-complement pair with `strands` = `both`) present in at least `minSequences` of the S input sequences, the expected frequency, the expected number of matching sequences exp_ms = S·(1 − (1 − p)^(nb_pos/S)), and the binomial significance ms_P = P(X ≥ mseq), X ~ Bin(S, exp_ms/S), ms_E = ms_P × possible oligos, ms_sig = −log10 ms_E. Same background models as `oligo_analysis`. Values beyond the double range are returned as null. `degenerate` = `oneN` / `onedeg` (RSAT `-oneN` / `-onedeg` with `-return mseq,proba`; `MotifFinder.FindSharedMotifs(…, pseudoFrequency, OligoDegeneracy)`): words with one N or one IUPAC code (R Y W S M K H B V D N); a sequence matches a degenerate word when one of its k-mers matches it (mseq = union of the matching sequences of its words), exp_freq = Σ over the matching words, NPO = k·|codes|·4^(k−1) (pairs with `-2str`).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequences": {
        "type": "array",
        "description": "DNA sequences",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "k": {
        "type": "integer",
        "description": "Word length (>= 1, default 6)",
        "minimum": 1,
        "default": 6
      },
      "minSequences": {
        "type": "integer",
        "description": "Matching-sequence quorum (>= 1, default 2)",
        "minimum": 1,
        "default": 2
      },
      "background": {
        "type": "string",
        "description": "Background model: 'input' (Bernoulli from input, default), 'equiprobable', 'bernoulli' (needs residueFrequencies), 'markov' (order markovOrder from input), 'markov_table' (needs oligoFrequencies)",
        "enum": [
          "input",
          "equiprobable",
          "bernoulli",
          "markov",
          "markov_table"
        ],
        "default": "input"
      },
      "markovOrder": {
        "type": "integer",
        "description": "Markov order for background 'markov' (>= 0; <= k-2 when > 0; default 1)",
        "minimum": 0,
        "default": 1
      },
      "residueFrequencies": {
        "type": "array",
        "description": "Residue probabilities A,C,G,T for background 'bernoulli'",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "oligoFrequencies": {
        "type": "object",
        "description": "(m+1)-mer -> frequency table for background 'markov_table' (RSAT -bgfile oligos format)",
        "additionalProperties": {
          "type": "number"
        }
      },
      "pseudoFrequency": {
        "type": "number",
        "description": "Pseudo-frequency in [0,1] for background 'markov_table' (default 0.01)",
        "minimum": 0,
        "maximum": 1,
        "default": 0.01
      },
      "strandInsensitive": {
        "type": "boolean",
        "description": "The 'markov_table' frequencies are strand-insensitive pair frequencies (default false)",
        "default": false
      },
      "strands": {
        "type": "string",
        "description": "'single' (default) or 'both'",
        "enum": [
          "single",
          "both"
        ],
        "default": "single"
      },
      "degenerate": {
        "type": "string",
        "enum": [
          "none",
          "oneN",
          "onedeg"
        ],
        "default": "none",
        "description": "'none' (default), 'oneN' (RSAT -oneN) or 'onedeg' (RSAT -onedeg: one of R Y W S M K H B V D N per word); a sequence matches a degenerate word when one of its k-mers matches it"
      }
    },
    "required": [
      "sequences"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "motifs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "string"
            },
            "reverseComplement": {
              "type": [
                "string",
                "null"
              ]
            },
            "sequenceIndices": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "prevalence": {
              "type": "number"
            },
            "expectedFrequency": {
              "type": "number"
            },
            "expectedMatchingSequences": {
              "type": "number"
            },
            "matchingSequenceProbability": {
              "type": "number"
            },
            "matchingSequenceEValue": {
              "type": [
                "number",
                "null"
              ]
            },
            "matchingSequenceSignificance": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "sequence",
            "sequenceIndices",
            "prevalence",
            "expectedFrequency",
            "expectedMatchingSequences",
            "matchingSequenceProbability"
          ]
        }
      },
      "oligoLength": {
        "type": "integer"
      },
      "strands": {
        "type": "string"
      },
      "sequenceCount": {
        "type": "integer"
      },
      "possiblePositions": {
        "type": "integer"
      },
      "possibleOligos": {
        "type": [
          "number",
          "null"
        ]
      },
      "degenerate": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "motifs",
      "oligoLength",
      "strands",
      "sequenceCount",
      "possiblePositions"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "At least one sequence is required"
    },
    {
      "code": 1001,
      "message": "Invalid DNA sequence"
    },
    {
      "code": 1002,
      "message": "k must be >= 1"
    },
    {
      "code": 1003,
      "message": "minSequences must be >= 1"
    },
    {
      "code": 1004,
      "message": "Background must be 'input', 'equiprobable', 'bernoulli', 'markov' or 'markov_table'"
    },
    {
      "code": 1005,
      "message": "Strands must be 'single' or 'both'"
    },
    {
      "code": 1006,
      "message": "degenerate must be 'none', 'oneN' or 'onedeg'."
    }
  ],
