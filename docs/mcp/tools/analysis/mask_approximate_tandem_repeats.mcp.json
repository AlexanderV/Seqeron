{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "mask_approximate_tandem_repeats",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RepeatFinder.MaskApproximateTandemRepeats",
  "docRef": "Seqeron.Genomics.Analysis/RepeatFinder.cs#L1039",
  "description": "Returns TRF's masked sequence (trf ... -m; TRF README: \"every location that occurred in a tandem repeat changed to the letter 'N'\"): every position inside a repeat reported by find_approximate_tandem_repeats with the same TRF parameters becomes N, or — with softMask — lower case. Positions outside repeats keep the input characters (TRF itself upper-cases its whole output). Same length as the input. Defaults = TRF recommended 2 7 7 80 10 50 500.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "Sequence (case-insensitive; any non-A/C/G/T symbol never matches)",
        "minLength": 1
      },
      "maxPeriod": {
        "type": "integer",
        "description": "TRF MaxPeriod",
        "minimum": 1,
        "maximum": 2000,
        "default": 500
      },
      "minScore": {
        "type": "integer",
        "description": "TRF Minscore",
        "minimum": 1,
        "default": 50
      },
      "matchWeight": {
        "type": "integer",
        "description": "TRF Match weight",
        "minimum": 1,
        "default": 2
      },
      "mismatchPenalty": {
        "type": "integer",
        "description": "TRF Mismatch penalty",
        "minimum": 1,
        "default": 7
      },
      "indelPenalty": {
        "type": "integer",
        "description": "TRF Delta (indel penalty)",
        "minimum": 1,
        "default": 7
      },
      "matchProbability": {
        "type": "integer",
        "description": "TRF PM in percent (80 or 75)",
        "enum": [
          80,
          75
        ],
        "default": 80
      },
      "indelProbability": {
        "type": "integer",
        "description": "TRF PI in percent",
        "minimum": 1,
        "maximum": 100,
        "default": 10
      },
      "maxRepeatLength": {
        "type": "integer",
        "description": "TRF -l: maximum tandem-repeat length in bp",
        "minimum": 1,
        "default": 2000000
      },
      "eliminateRedundancy": {
        "type": "boolean",
        "description": "Redundancy elimination (TRF -r turns it off)",
        "default": true
      },
      "softMask": {
        "type": "boolean",
        "description": "Lower-case repeat positions instead of writing N",
        "default": false
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "masked": {
        "type": "string"
      }
    },
    "required": [
      "masked"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1003,
      "message": "TRF parameter out of range (weights >= 1, PM 80/75, PI 1-100, MaxPeriod 1-2000, -l >= 1)"
    }
  ],
  "examples": [
    {
      "name": "Hard mask = TRF -m file",
      "input": {
        "sequence": "CACACACACACACACACGCACACACACACCGACACACACACACACACACACACACACACAAGATCGTCAACGACCATCGTTCTTCTGCTTTAAGTGTGAGTTCTCTCTTACAAGCTAATACACCCCAGCGTTCTCCGTAC"
      },
      "output": {
        "masked": "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNAGATCGTCAACGACCATCGTTCTTCTGCTTTAAGTGTGAGTTCTCTCTTACAAGCTAATACACCCCAGCGTTCTCCGTAC"
      }
    },
    {
      "name": "Soft mask",
      "input": {
        "sequence": "CACACACACACACACACGCACACACACACCGACACACACACACACACACACACACACACAAGATCGTCAACGACCATCGTTCTTCTGCTTTAAGTGTGAGTTCTCTCTTACAAGCTAATACACCCCAGCGTTCTCCGTAC",
        "softMask": true
      },
      "output": {
        "masked": "cacacacacacacacacgcacacacacaccgacacacacacacacacacacacacacacaAGATCGTCAACGACCATCGTTCTTCTGCTTTAAGTGTGAGTTCTCTCTTACAAGCTAATACACCCCAGCGTTCTCCGTAC"
      }
    }
  ]
}
