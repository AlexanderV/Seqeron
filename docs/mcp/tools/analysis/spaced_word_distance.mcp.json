{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "spaced_word_distance",
  "serverName": "Analysis",
  "version": "1.1.0",
  "stability": "stable",
  "methodId": "KmerAnalyzer.SpacedWordDistance",
  "docRef": "Seqeron.Genomics.Analysis/KmerAnalyzer.cs#L1883",
  "description": "Multiple-pattern spaced-word distance (Leimeister et al. 2014): for each binary pattern (all of equal weight) count the spaced words of both sequences, compute the word-vector distance, and average over the patterns. metric: euclidean (default, relative frequencies), jensen_shannon (JS divergence base 2, = spaced -d JS), euclidean_counts (= spaced -d EU), or another kmer_distance word-vector metric. Single strand (spaced -r).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "seq1": {
        "type": "string",
        "description": "First sequence",
        "minLength": 1
      },
      "seq2": {
        "type": "string",
        "description": "Second sequence",
        "minLength": 1
      },
      "patterns": {
        "type": "array",
        "description": "Binary patterns over {0,1}, each starting and ending with 1, all with the same number of 1s",
        "items": {
          "type": "string",
          "pattern": "^1([01]*1)?$"
        },
        "minItems": 1
      },
      "metric": {
        "type": "string",
        "description": "Per-pattern word-vector metric",
        "enum": [
          "euclidean",
          "jensen_shannon",
          "js",
          "euclidean_counts",
          "squared_euclidean_counts",
          "manhattan",
          "chebyshev",
          "canberra",
          "cosine",
          "d2"
        ],
        "default": "euclidean"
      },
      "acgtOnly": {
        "type": "boolean",
        "description": "Drop spaced words with a non-ACGT symbol at a match position (the spaced program's rule); frequencies stay count / number of windows",
        "default": false
      },
      "bothStrands": {
        "type": "boolean",
        "description": "spaced's default reverse-complement mode (spaced without -r): seq1 counted on both strands vs seq2 forward; order-dependent",
        "default": false
      }
    },
    "required": [
      "seq1",
      "seq2",
      "patterns"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "distance": {
        "type": "number",
        "description": "Mean of the per-pattern metric values"
      }
    },
    "required": [
      "distance"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "At least one pattern is required."
    },
    {
      "code": 1002,
      "message": "All patterns must have the same weight (number of '1' positions)."
    },
    {
      "code": 1002,
      "message": "Pattern must be a non-empty string over {0,1} that starts and ends with '1'."
    },
    {
      "code": 1002,
      "message": "D2*/D2S need each sequence's background model; use KmerDistance(string, string, int, metric) or BackgroundAdjustedD2."
    },
    {
      "code": 1002,
      "message": "metric must be one of: euclidean, squared_euclidean_counts, manhattan, chebyshev, canberra, cosine, d2, d2star, d2shepherd, jensen_shannon, euclidean_counts"
    }
  ],
  "examples": [
    {
      "name": "Jensen-Shannon over three weight-4 patterns (= spaced -r -d JS)",
      "input": {
        "seq1": "AGGTAAGGTGGTTGAGATCTGGACTTTTGACGCCTGGAGCCCGCAGTGCTCCTCGAAAAGTAGCCATGCCTTGGGCTGCT",
        "seq2": "CAAAGGCCCTACCTTCTTATAGTCCTTTCAACATACAAGTATAGTTGGAAGTTCTAAGTTCAGTTTAATC",
        "patterns": [
          "11011",
          "10111",
          "11101"
        ],
        "metric": "jensen_shannon"
      },
      "output": {
        "distance": 0.8163228541607376
      }
    },
    {
      "name": "Euclidean on relative frequencies (default)",
      "input": {
        "seq1": "AGGTAAGGTGGTTGAGATCTGGACTTTTGACGCCTGGAGCCCGCAGTGCTCCTCGAAAAGTAGCCATGCCTTGGGCTGCT",
        "seq2": "CAAAGGCCCTACCTTCTTATAGTCCTTTCAACATACAAGTATAGTTGGAAGTTCTAAGTTCAGTTTAATC",
        "patterns": [
          "11011",
          "10111",
          "11101"
        ]
      },
      "output": {
        "distance": 0.17567404832368613
      }
    },
    {
      "name": "Euclidean on counts (= spaced -r -d EU)",
      "input": {
        "seq1": "AGGTAAGGTGGTTGAGATCTGGACTTTTGACGCCTGGAGCCCGCAGTGCTCCTCGAAAAGTAGCCATGCCTTGGGCTGCT",
        "seq2": "CAAAGGCCCTACCTTCTTATAGTCCTTTCAACATACAAGTATAGTTGGAAGTTCTAAGTTCAGTTTAATC",
        "patterns": [
          "11011",
          "10111",
          "11101"
        ],
        "metric": "euclidean_counts"
      },
      "output": {
        "distance": 12.40897581662776
      }
    },
    {
      "name": "spaced default mode (both strands, N dropped) = spaced -d JS without -r",
      "input": {
        "seq1": "AGGTAAGGTGNGTTGAGATctggacTTTTGACGCCTRGAGCCCGCAGTGCTCCTCGAAAAGTAGCNNATGCCTTGGGCTGCT",
        "seq2": "CAAAGGCCCTACCTTCTTATAGTCCTTYCAACATACAAGTAtagttgGAAGTTCTAAGTTCAGNTTAATC",
        "patterns": [
          "11011",
          "10111",
          "11101"
        ],
        "metric": "jensen_shannon",
        "acgtOnly": true,
        "bothStrands": true
      },
      "output": {
        "distance": 0.6447798019943918
      }
    }
  ]
}
