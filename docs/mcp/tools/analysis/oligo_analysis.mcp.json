{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "oligo_analysis",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "MotifFinder.DiscoverMotifs",
  "docRef": "Seqeron.Genomics.Analysis/MotifFinder.OligoAnalysis.cs#L58",
  "description": "RSAT `oligo-analysis` (van Helden et al. 1998) over-representation of the length-k words of one DNA sequence (the RSAT overload of `MotifFinder.DiscoverMotifs`): for every word (or reverse-complement pair with `strands` = `both`, RSAT `-2str`) with occ ≥ `minCount`, the expected frequency under the background model, exp_occ, the ratio occ/exp_occ and the binomial right-tail significance occ_P = P(X ≥ occ), X ~ Bin(N−k+1, exp_freq), occ_E = occ_P × tested patterns, occ_sig = −log10 occ_E. Backgrounds: `equiprobable` (`-bg equi`), `input` (Bernoulli from input, RSAT default), `bernoulli` (given A,C,G,T), `markov` (order m from input, `-markov m`), `markov_table` (RSAT `-bgfile` oligo frequencies with pseudo-frequency). `countOverlapping` = false is RSAT `-noov`. Reproduces the RSAT perl code (≤ 1e-12). Values beyond the double range (`ratio`, `possibleOligos` for very long k) are returned as null. RSAT options (routed to `MotifFinder.AnalyzeOligos`): `extraSequences` (multi-sequence input), `zscore` (RSAT `-return zscore`: exp_var = n·p·(2·ovlp − 1 − (2k+1)·p), or exp_occ with `-noov`; ovlp = Pevzner overlap coefficient), `expectedFrequencyPseudo` (RSAT `-pseudo`: exp_freq ← (1 − ψ)·exp_freq + ψ/NPO per strand), `degenerate` (`oneN` / `onedeg`: one IUPAC position, occ and exp_freq summed over matching words), background `lexicon` (RSAT `-lexicon` segmentation frequencies), `calibrationTable` + `calibrationMode` (RSAT `-calibN` / `-calib1`: P(occ ≤ X ≤ n) under a negative binomial when mean < variance, else Poisson). Patterns without a valid expected frequency (RSAT \"NA\") are omitted in this mode.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "DNA sequence",
        "minLength": 1
      },
      "k": {
        "type": "integer",
        "description": "Oligonucleotide length (>= 1, default 6)",
        "minimum": 1,
        "default": 6
      },
      "minCount": {
        "type": "integer",
        "description": "Occurrence threshold (RSAT -lth occ, default 2)",
        "default": 2
      },
      "background": {
        "type": "string",
        "description": "Background model: 'input' (Bernoulli from input, default), 'equiprobable', 'bernoulli' (needs residueFrequencies), 'markov' (order markovOrder from input), 'markov_table' (needs oligoFrequencies), 'lexicon' (RSAT -lexicon, k >= 2)",
        "enum": [
          "input",
          "equiprobable",
          "bernoulli",
          "markov",
          "markov_table",
          "lexicon"
        ],
        "default": "input"
      },
      "markovOrder": {
        "type": "integer",
        "description": "Markov order for background 'markov' (>= 0; <= k-2 when > 0; default 1)",
        "minimum": 0,
        "default": 1
      },
      "residueFrequencies": {
        "type": "array",
        "description": "Residue probabilities A,C,G,T for background 'bernoulli'",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "oligoFrequencies": {
        "type": "object",
        "description": "(m+1)-mer -> frequency table for background 'markov_table' (RSAT -bgfile oligos format)",
        "additionalProperties": {
          "type": "number"
        }
      },
      "pseudoFrequency": {
        "type": "number",
        "description": "Pseudo-frequency in [0,1] for background 'markov_table' (default 0.01)",
        "minimum": 0,
        "maximum": 1,
        "default": 0.01
      },
      "strandInsensitive": {
        "type": "boolean",
        "description": "The 'markov_table' frequencies are strand-insensitive pair frequencies (default false)",
        "default": false
      },
      "strands": {
        "type": "string",
        "description": "'single' (-1str, default) or 'both' (-2str)",
        "enum": [
          "single",
          "both"
        ],
        "default": "single"
      },
      "countOverlapping": {
        "type": "boolean",
        "description": "Count overlapping occurrences (default true); false = -noov",
        "default": true
      },
      "extraSequences": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Additional DNA sequences analysed together with 'sequence' (RSAT multi-sequence input)"
      },
      "zscore": {
        "type": "boolean",
        "default": false,
        "description": "Also report expectedVariance, overlapCoefficient and zScore (RSAT -return zscore; default false)"
      },
      "expectedFrequencyPseudo": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0,
        "description": "RSAT -pseudo: pseudo-frequency psi in [0,1] on the expected frequencies (default 0 = off)"
      },
      "degenerate": {
        "type": "string",
        "enum": [
          "none",
          "oneN",
          "onedeg"
        ],
        "default": "none",
        "description": "'none' (default), 'oneN' (RSAT -oneN) or 'onedeg' (RSAT -onedeg: one of R Y W S M K H B V D N per word)"
      },
      "calibrationTable": {
        "type": "string",
        "description": "RSAT calibration file text (-calibN / -calib1; word [id] mean sd variance ...)"
      },
      "calibrationMode": {
        "type": "string",
        "enum": [
          "set",
          "sequence"
        ],
        "default": "set",
        "description": "'set' (-calibN, default) or 'sequence' (-calib1: mean and variance × number of sequences)"
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "motifs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "string"
            },
            "reverseComplement": {
              "type": [
                "string",
                "null"
              ]
            },
            "count": {
              "type": "integer"
            },
            "positions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "expectedFrequency": {
              "type": "number"
            },
            "expectedOccurrences": {
              "type": "number"
            },
            "ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "occurrenceProbability": {
              "type": "number"
            },
            "occurrenceEValue": {
              "type": "number"
            },
            "occurrenceSignificance": {
              "type": "number"
            },
            "sequenceIndices": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer"
              }
            },
            "overlaps": {
              "type": [
                "integer",
                "null"
              ]
            },
            "observedFrequency": {
              "type": [
                "number",
                "null"
              ]
            },
            "expectedVariance": {
              "type": [
                "number",
                "null"
              ]
            },
            "overlapCoefficient": {
              "type": [
                "number",
                "null"
              ]
            },
            "zScore": {
              "type": [
                "number",
                "null"
              ]
            },
            "fittedDistribution": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Binomial",
                "Poisson",
                "NegativeBinomial",
                null
              ]
            },
            "lexiconSegmentation": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "sequence",
            "count",
            "positions",
            "expectedFrequency",
            "expectedOccurrences",
            "occurrenceProbability",
            "occurrenceEValue",
            "occurrenceSignificance"
          ]
        }
      },
      "oligoLength": {
        "type": "integer"
      },
      "strands": {
        "type": "string"
      },
      "countOverlapping": {
        "type": "boolean"
      },
      "totalOccurrences": {
        "type": "integer"
      },
      "testedPatterns": {
        "type": "integer"
      },
      "possibleOligos": {
        "type": [
          "number",
          "null"
        ]
      },
      "sequenceCount": {
        "type": [
          "integer",
          "null"
        ]
      },
      "degenerate": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "motifs",
      "oligoLength",
      "strands",
      "countOverlapping",
      "totalOccurrences",
      "testedPatterns"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1001,
      "message": "Invalid DNA sequence"
    },
    {
      "code": 1002,
      "message": "k must be >= 1"
    },
    {
      "code": 1003,
      "message": "Background must be 'input', 'equiprobable', 'bernoulli', 'markov', 'markov_table' or 'lexicon'"
    },
    {
      "code": 1004,
      "message": "Background 'bernoulli' requires 4 residueFrequencies (A,C,G,T)"
    },
    {
      "code": 1005,
      "message": "Background 'markov_table' requires oligoFrequencies"
    },
    {
      "code": 1006,
      "message": "Strands must be 'single' or 'both'"
    },
    {
      "code": 1007,
      "message": "degenerate must be 'none', 'oneN' or 'onedeg'."
    },
    {
      "code": 1008,
      "message": "expectedFrequencyPseudo must be in [0, 1]."
    },
    {
      "code": 1009,
      "message": "calibrationMode must be 'set' or 'sequence'."
    },
    {
      "code": 1009,
      "message": "Calibration line N: expected <pattern> [id] <mean> <sd> <variance>"
    }
  ],
