{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "alignment_distance_matrix",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "MultipleAlignmentStatistics.CalculateDistanceMatrix",
  "docRef": "Seqeron.Genomics.Analysis/MultipleAlignmentStatistics.cs#L220",
  "description": "Pairwise distance matrix of a multiple alignment as EMBOSS 6.6.0 distmat: matches = columns where both rows carry the same non-gap symbol, g = columns where either row has a gap; 'uncorrected' D = 1 - matches/(L - g + g*gapWeight); 'jukes-cantor' -b*ln(1 - D/b) with b = 3/4 (nucleotide) or 19/20 (protein). Fractions, not percent; entries with a zero denominator or a saturated logarithm are null.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequences": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "At least two aligned sequences of equal length.",
        "minItems": 2
      },
      "method": {
        "type": "string",
        "description": "'uncorrected' (default) or 'jukes-cantor'.",
        "default": "uncorrected"
      },
      "residueType": {
        "type": "string",
        "description": "'auto' (default), 'nucleotide' or 'protein' (selects the Jukes-Cantor constant b).",
        "default": "auto"
      },
      "gapWeight": {
        "type": "number",
        "description": "distmat -gapweight (default 0).",
        "default": 0
      }
    },
    "required": [
      "sequences"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "method": {
        "type": "string",
        "description": "Method used."
      },
      "matrix": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "description": "Symmetric distance matrix (fractions, zero diagonal; null = undefined or saturated)."
      }
    },
    "required": [
      "method",
      "matrix"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "At least two sequences are required"
    },
    {
      "code": 1002,
      "message": "method must be 'uncorrected' or 'jukes-cantor'"
    }
  ],
  "examples": [
    {
      "name": "EMBOSS infoalign/distmat example",
      "input": {
        "sequences": [
          "ACGT-ACGTAC",
          "ACGTTACG-AC",
          "AGGT-ACGTAC",
          "A-GTTTCGTAA"
        ]
      },
      "output": {
        "note": "matrix[0][2] = 0.1, matrix[1][2] = 0.1111 (EMBOSS distmat 6.6.0: 10.00, 11.11 percent)"
      }
    }
  ]
}
