{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "semi_global_align_affine",
  "serverName": "Alignment",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceAligner.SemiGlobalAlignAffine",
  "docRef": "Seqeron.Genomics.Alignment/SequenceAligner.cs#L910",
  "description": "Semi-global (fitting) pairwise alignment with affine gap costs: sequence1 is aligned end to end inside sequence2 (free leading/trailing sequence2 residues); a gap of length k scores gapOpen + k·gapExtend. Equals Biopython PairwiseAligner(mode='global', end_insertion_score=0) and parasail sg_dx.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence1": {
        "type": "string",
        "description": "Query sequence (typically shorter).",
        "minLength": 1
      },
      "sequence2": {
        "type": "string",
        "description": "Reference sequence (typically longer).",
        "minLength": 1
      },
      "match": {
        "type": "integer",
        "description": "Score for matching base.",
        "default": 1
      },
      "mismatch": {
        "type": "integer",
        "description": "Score for mismatching base.",
        "default": -1
      },
      "gapOpen": {
        "type": "integer",
        "description": "Gap-open score added once per gap run (negative = penalty).",
        "default": -2
      },
      "gapExtend": {
        "type": "integer",
        "description": "Gap score per gap position, in addition to gapOpen for the first one.",
        "default": -1
      }
    },
    "required": [
      "sequence1",
      "sequence2"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "alignedSequence1": {
        "type": "string",
        "description": "Aligned sequence1 (with '-' gaps)."
      },
      "alignedSequence2": {
        "type": "string",
        "description": "Aligned sequence2 (with '-' gaps)."
      },
      "score": {
        "type": "integer",
        "description": "Alignment score."
      },
      "alignmentType": {
        "type": "string",
        "description": "Alignment type (Global, Local or SemiGlobal)."
      },
      "startPosition1": {
        "type": "integer",
        "description": "0-based start in sequence1."
      },
      "startPosition2": {
        "type": "integer",
        "description": "0-based start in sequence2."
      },
      "endPosition1": {
        "type": "integer",
        "description": "0-based end in sequence1."
      },
      "endPosition2": {
        "type": "integer",
        "description": "0-based end in sequence2."
      }
    },
    "required": [
      "alignedSequence1",
      "alignedSequence2",
      "score",
      "alignmentType",
      "startPosition1",
      "startPosition2",
      "endPosition1",
      "endPosition2"
    ]
  },
  "errors": [
    {
      "code": 1010,
      "message": "Invalid DNA in sequence1/sequence2"
    }
  ],
  "examples": [
    {
      "name": "Fit GATTACA, blastn scoring",
      "input": {
        "sequence1": "GATTACA",
        "sequence2": "CCGATTTACAGG",
        "match": 2,
        "mismatch": -3,
        "gapOpen": -5,
        "gapExtend": -2
      },
      "output": {
        "alignedSequence1": "--GA-TTACA--",
        "alignedSequence2": "CCGATTTACAGG",
        "score": 7,
        "alignmentType": "SemiGlobal",
        "startPosition1": 0,
        "startPosition2": 0,
        "endPosition1": 6,
        "endPosition2": 11
      }
    }
  ]
}
