{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "assemble_de_bruijn",
  "serverName": "Alignment",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceAssembler.AssembleDeBruijn",
  "docRef": "Seqeron.Genomics.Alignment/SequenceAssembler.cs#L101",
  "description": "Assemble reads using a de Bruijn graph: shred reads into their distinct k-mers (case-insensitive; coverage adds no edges), build the (k-1)-mer node graph, output every maximal non-branching path (unitig) and isolated cycle as a contig, then report N50 / longest / total length. Optionally add reverse-complement k-mers (double-stranded reads).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "reads": {
        "type": "array",
        "description": "Input sequence reads."
      },
      "minOverlap": {
        "type": "integer",
        "description": "Minimum overlap length (shared parameter; not the operative knob here).",
        "default": 20
      },
      "minIdentity": {
        "type": "number",
        "description": "Minimum identity (shared parameter).",
        "default": 0.9
      },
      "kmerSize": {
        "type": "integer",
        "description": "K-mer size used to build the de Bruijn graph (>= 2; odd recommended with includeReverseComplement).",
        "default": 31
      },
      "minContigLength": {
        "type": "integer",
        "description": "Minimum contig length to keep (bp).",
        "default": 100
      },
      "includeReverseComplement": {
        "type": "boolean",
        "description": "Treat reads as double-stranded DNA: add each k-mer's reverse complement (Velvet).",
        "default": false
      }
    },
    "required": [
      "reads"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "contigs": {
        "type": "array",
        "description": "Assembled contig sequences."
      },
      "totalReads": {
        "type": "integer",
        "description": "Number of input reads."
      },
      "assembledReads": {
        "type": "integer",
        "description": "Reads with at least one k-mer (either strand with includeReverseComplement) in a reported contig (Velvet usedReads)."
      },
      "n50": {
        "type": "number",
        "description": "N50 contig length."
      },
      "longestContig": {
        "type": "integer",
        "description": "Longest contig length (bp)."
      },
      "totalLength": {
        "type": "integer",
        "description": "Total assembled length (bp)."
      }
    },
    "required": [
      "contigs",
      "totalReads",
      "assembledReads",
      "n50",
      "longestContig",
      "totalLength"
    ]
  },
  "errors": [
    {
      "code": 4001,
      "message": "Assembly failed"
    }
  ],
  "examples": [
    {
      "name": "Overlapping reads",
      "input": {
        "reads": [
          "ATGGCGT",
          "GGCGTGCA"
        ],
        "kmerSize": 4,
        "minContigLength": 4
      },
      "output": {
        "contigs": [
          "ATGGCGTGCA"
        ],
        "totalReads": 2,
        "assembledReads": 2,
        "n50": 10,
        "longestContig": 10,
        "totalLength": 10
      }
    },
    {
      "name": "Branching graph yields unitigs",
      "input": {
        "reads": [
          "AAABBB",
          "AABBBC"
        ],
        "kmerSize": 3,
        "minContigLength": 3
      },
      "output": {
        "contigs": [
          "AAA",
          "AABB",
          "BBB",
          "BBC"
        ],
        "totalReads": 2,
        "assembledReads": 2,
        "n50": 3,
        "longestContig": 4,
        "totalLength": 13
      }
    },
    {
      "name": "Empty read set",
      "input": {
        "reads": [],
        "kmerSize": 3,
        "minContigLength": 3
      },
      "output": {
        "contigs": [],
        "totalReads": 0,
        "assembledReads": 0,
        "n50": 0,
        "longestContig": 0,
        "totalLength": 0
      }
    }
  ]
}
