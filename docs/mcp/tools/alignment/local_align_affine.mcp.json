{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "local_align_affine",
  "serverName": "Alignment",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceAligner.LocalAlignAffine",
  "docRef": "Seqeron.Genomics.Alignment/SequenceAligner.cs#L807",
  "description": "Local pairwise alignment with affine gap costs (Smith-Waterman 1981 with Gotoh 1982 gaps): a gap of length k scores gapOpen + k·gapExtend; zero floor. Equals Biopython PairwiseAligner(mode='local') and parasail sw_trace.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence1": {
        "type": "string",
        "description": "First sequence.",
        "minLength": 1
      },
      "sequence2": {
        "type": "string",
        "description": "Second sequence.",
        "minLength": 1
      },
      "match": {
        "type": "integer",
        "description": "Score for matching base.",
        "default": 1
      },
      "mismatch": {
        "type": "integer",
        "description": "Score for mismatching base.",
        "default": -1
      },
      "gapOpen": {
        "type": "integer",
        "description": "Gap-open score added once per gap run (negative = penalty).",
        "default": -2
      },
      "gapExtend": {
        "type": "integer",
        "description": "Gap score per gap position, in addition to gapOpen for the first one.",
        "default": -1
      }
    },
    "required": [
      "sequence1",
      "sequence2"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "alignedSequence1": {
        "type": "string",
        "description": "Aligned sequence1 (with '-' gaps)."
      },
      "alignedSequence2": {
        "type": "string",
        "description": "Aligned sequence2 (with '-' gaps)."
      },
      "score": {
        "type": "integer",
        "description": "Alignment score."
      },
      "alignmentType": {
        "type": "string",
        "description": "Alignment type (Global, Local or SemiGlobal)."
      },
      "startPosition1": {
        "type": "integer",
        "description": "0-based start in sequence1."
      },
      "startPosition2": {
        "type": "integer",
        "description": "0-based start in sequence2."
      },
      "endPosition1": {
        "type": "integer",
        "description": "0-based end in sequence1."
      },
      "endPosition2": {
        "type": "integer",
        "description": "0-based end in sequence2."
      }
    },
    "required": [
      "alignedSequence1",
      "alignedSequence2",
      "score",
      "alignmentType",
      "startPosition1",
      "startPosition2",
      "endPosition1",
      "endPosition2"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    }
  ],
  "examples": [
    {
      "name": "Local window, blastn scoring",
      "input": {
        "sequence1": "GGGACGTTTACGTCCC",
        "sequence2": "TTACGTACGTAA",
        "match": 2,
        "mismatch": -3,
        "gapOpen": -5,
        "gapExtend": -2
      },
      "output": {
        "alignedSequence1": "TTACGT",
        "alignedSequence2": "TTACGT",
        "score": 12,
        "alignmentType": "Local",
        "startPosition1": 7,
        "startPosition2": 0,
        "endPosition1": 12,
        "endPosition2": 5
      }
    }
  ]
}
