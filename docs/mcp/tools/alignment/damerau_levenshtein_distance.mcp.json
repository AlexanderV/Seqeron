{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "damerau_levenshtein_distance",
  "serverName": "Alignment",
  "version": "1.1.0",
  "stability": "stable",
  "methodId": "ApproximateMatcher.DamerauLevenshteinDistance",
  "docRef": "Seqeron.Genomics.Alignment/ApproximateMatcher.cs#L1016",
  "description": "Edit distance with adjacent transpositions. variant 'unrestricted' (default) is the true Damerau–Levenshtein metric (Lowrance & Wagner 1975; DL(CA,ABC)=2); 'osa' is the optimal string alignment (restricted) distance where no substring is edited twice (OSA(CA,ABC)=3). Case-sensitive. Optional insertionCost/deletionCost/substitutionCost/transpositionCost (default 1) give the weighted distance (sequence1 = s1 transformed into sequence2: insertion adds a sequence2 character, deletion removes a sequence1 character); 'unrestricted' requires 2*transpositionCost >= insertionCost + deletionCost (Lowrance-Wagner exactness condition).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence1": {
        "type": "string",
        "description": "First sequence.",
        "minLength": 1
      },
      "sequence2": {
        "type": "string",
        "description": "Second sequence.",
        "minLength": 1
      },
      "variant": {
        "type": "string",
        "description": "'unrestricted' (true Damerau–Levenshtein, default) or 'osa' (optimal string alignment).",
        "enum": [
          "unrestricted",
          "osa"
        ],
        "default": "unrestricted"
      },
      "insertionCost": {
        "type": "integer",
        "description": "Cost of inserting a sequence2 character (>= 0; default 1).",
        "minimum": 0,
        "default": 1
      },
      "deletionCost": {
        "type": "integer",
        "description": "Cost of deleting a sequence1 character (>= 0; default 1).",
        "minimum": 0,
        "default": 1
      },
      "substitutionCost": {
        "type": "integer",
        "description": "Cost of a substitution (>= 0; default 1).",
        "minimum": 0,
        "default": 1
      },
      "transpositionCost": {
        "type": "integer",
        "description": "Cost of swapping two adjacent characters (>= 0; default 1; 'unrestricted' needs 2*transpositionCost >= insertionCost + deletionCost).",
        "minimum": 0,
        "default": 1
      }
    },
    "required": [
      "sequence1",
      "sequence2"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "distance": {
        "type": "integer"
      },
      "variant": {
        "type": "string",
        "enum": [
          "unrestricted",
          "osa"
        ]
      }
    },
    "required": [
      "distance",
      "variant"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1004,
      "message": "Variant must be 'unrestricted' or 'osa'"
    },
    {
      "code": 1004,
      "message": "Costs must be >= 0; 'unrestricted' requires 2*transpositionCost >= insertionCost + deletionCost"
    }
  ],
  "examples": [
    {
      "name": "True Damerau–Levenshtein",
      "input": {
        "sequence1": "CA",
        "sequence2": "ABC"
      },
      "output": {
        "distance": 2,
        "variant": "unrestricted"
      }
    },
    {
      "name": "Optimal string alignment",
      "input": {
        "sequence1": "CA",
        "sequence2": "ABC",
        "variant": "osa"
      },
      "output": {
        "distance": 3,
        "variant": "osa"
      }
    },
    {
      "name": "Weighted Damerau–Levenshtein",
      "input": {
        "sequence1": "CA",
        "sequence2": "ABC",
        "insertionCost": 2,
        "deletionCost": 3,
        "substitutionCost": 4,
        "transpositionCost": 3
      },
      "output": {
        "distance": 5,
        "variant": "unrestricted"
      }
    }
  ]
}
