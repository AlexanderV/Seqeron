{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "toolName": "tcoffee_ktup_similarity",
 "serverName": "Alignment",
 "version": "1.0.0",
 "stability": "stable",
 "methodId": "SequenceAligner.TCoffeeKtupSimilarity",
 "docRef": "Seqeron.Genomics.Alignment/SequenceAligner.TCoffeeTree.cs",
 "description": "The pairwise k-tuple similarity matrix T-Coffee 13.41 computes for its guide tree (-distance_matrix_mode ktup: shared k-tuples of the two sequences, k = 1 for protein / 2 for DNA reduced alphabet as in the program), as the integer matrix the program stores (symmetric; the diagonal is the self similarity). Verified together with the guide tree (see tcoffee_guide_tree).",
 "inputSchema": {
  "type": "object",
  "properties": {
   "sequences": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "Sequences (at least one, none empty; letters only)."
   },
   "protein": {
    "type": "boolean",
    "description": "true = protein, false (default) = DNA.",
    "default": false
   }
  },
  "required": [
   "sequences"
  ]
 },
 "outputSchema": {
  "type": "object",
  "properties": {
   "similarity": {
    "type": "array",
    "items": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    }
   }
  },
  "required": [
   "similarity"
  ]
 },
 "errors": [
  {
   "code": 1001,
   "message": "sequences must contain at least one sequence"
  }
 ],
 "examples": [
  {
   "name": "Identical and disjoint",
   "input": {
    "sequences": [
     "AAAAAAA",
     "AAAAAAA",
     "CCCCCCC"
    ]
   },
   "output": {
    "similarity": [
     [
      100,
      100,
      70
     ],
     [
      100,
      100,
      70
     ],
     [
      70,
      70,
      100
     ]
    ]
   }
  }
 ]
}
