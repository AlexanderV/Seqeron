{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "global_align_affine",
  "serverName": "Alignment",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SequenceAligner.GlobalAlignAffine",
  "docRef": "Seqeron.Genomics.Alignment/SequenceAligner.cs#L387",
  "description": "Global pairwise alignment with affine gap costs (Gotoh 1982): a gap of length k scores gapOpen + k·gapExtend (BLAST+ / Biopython convention), border gaps are charged an opening each (Flouri et al. 2015). Equals Biopython PairwiseAligner(mode='global') and parasail nw_trace.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence1": {
        "type": "string",
        "description": "First sequence (DNA, uppercased internally).",
        "minLength": 1
      },
      "sequence2": {
        "type": "string",
        "description": "Second sequence.",
        "minLength": 1
      },
      "match": {
        "type": "integer",
        "description": "Score for matching base.",
        "default": 1
      },
      "mismatch": {
        "type": "integer",
        "description": "Score for mismatching base.",
        "default": -1
      },
      "gapOpen": {
        "type": "integer",
        "description": "Gap-open score added once per gap run (negative = penalty).",
        "default": -2
      },
      "gapExtend": {
        "type": "integer",
        "description": "Gap score per gap position, in addition to gapOpen for the first one.",
        "default": -1
      }
    },
    "required": [
      "sequence1",
      "sequence2"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "alignedSequence1": {
        "type": "string",
        "description": "Aligned sequence1 (with '-' gaps)."
      },
      "alignedSequence2": {
        "type": "string",
        "description": "Aligned sequence2 (with '-' gaps)."
      },
      "score": {
        "type": "integer",
        "description": "Alignment score."
      },
      "alignmentType": {
        "type": "string",
        "description": "Alignment type (Global, Local or SemiGlobal)."
      },
      "startPosition1": {
        "type": "integer",
        "description": "0-based start in sequence1."
      },
      "startPosition2": {
        "type": "integer",
        "description": "0-based start in sequence2."
      },
      "endPosition1": {
        "type": "integer",
        "description": "0-based end in sequence1."
      },
      "endPosition2": {
        "type": "integer",
        "description": "0-based end in sequence2."
      }
    },
    "required": [
      "alignedSequence1",
      "alignedSequence2",
      "score",
      "alignmentType",
      "startPosition1",
      "startPosition2",
      "endPosition1",
      "endPosition2"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    }
  ],
  "examples": [
    {
      "name": "Long gap, blastn scoring",
      "input": {
        "sequence1": "TTTTTTTTTTACGT",
        "sequence2": "ACGT",
        "match": 2,
        "mismatch": -3,
        "gapOpen": -5,
        "gapExtend": -2
      },
      "output": {
        "alignedSequence1": "TTTTTTTTTTACGT",
        "alignedSequence2": "----------ACGT",
        "score": -17,
        "alignmentType": "Global",
        "startPosition1": 0,
        "startPosition2": 0,
        "endPosition1": 13,
        "endPosition2": 3
      }
    }
  ]
}
