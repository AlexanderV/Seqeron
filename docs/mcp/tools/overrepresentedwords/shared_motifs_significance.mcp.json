{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "shared_motifs_significance",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "OverrepresentedWordAnalyzer.FindSharedMotifs",
  "docRef": "Seqeron.Genomics.OverrepresentedWords/OverrepresentedWordAnalyzer.OligoAnalysis.cs#L140",
  "description": "RSAT oligo-analysis matching-sequence statistics: k-mers (or reverse-complement pairs) present in at least minSequences of the input DNA sequences, with expected matching sequences exp_ms and binomial significance ms_P / ms_E / ms_sig under a background model; optionally degenerate words with one N or one IUPAC code (-oneN / -onedeg).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequences": {
        "type": "array",
        "description": "DNA sequences.",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "k": {
        "type": "integer",
        "description": "Word length k (>= 1, default 6).",
        "minimum": 1,
        "default": 6
      },
      "minSequences": {
        "type": "integer",
        "description": "Matching-sequence quorum (RSAT -lth mseq, >= 1, default 2).",
        "minimum": 1,
        "default": 2
      },
      "background": {
        "type": "string",
        "description": "Background model: 'input' (default), 'equiprobable', 'bernoulli' (needs residueFrequencies), 'markov' (order markovOrder) or 'markov_table' (needs oligoFrequencies).",
        "enum": [
          "input",
          "equiprobable",
          "bernoulli",
          "markov",
          "markov_table"
        ],
        "default": "input"
      },
      "markovOrder": {
        "type": "integer",
        "description": "Markov order for background 'markov' (default 1).",
        "minimum": 0,
        "default": 1
      },
      "residueFrequencies": {
        "type": "array",
        "description": "Residue probabilities A,C,G,T for background 'bernoulli'.",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "oligoFrequencies": {
        "type": "object",
        "description": "(m+1)-mer frequency table for background 'markov_table'.",
        "additionalProperties": {
          "type": "number"
        }
      },
      "pseudoFrequency": {
        "type": "number",
        "description": "Pseudo-frequency in [0,1] for background 'markov_table' (default 0.01).",
        "minimum": 0,
        "maximum": 1,
        "default": 0.01
      },
      "strandInsensitive": {
        "type": "boolean",
        "description": "The 'markov_table' frequencies are strand-insensitive pair frequencies (default false).",
        "default": false
      },
      "strands": {
        "type": "string",
        "description": "Strands: 'single' (default) or 'both' (reverse-complement pairs).",
        "enum": [
          "single",
          "both"
        ],
        "default": "single"
      },
      "degenerate": {
        "type": "string",
        "enum": [
          "none",
          "oneN",
          "onedeg"
        ],
        "default": "none",
        "description": "Degenerate words: 'none' (default), 'oneN' (-oneN, one N per word) or 'onedeg' (-onedeg, one IUPAC code R Y W S M K H B V D N per word); a sequence matches a degenerate word when one of its k-mers matches it."
      }
    },
    "required": [
      "sequences"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "motifs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "string"
            },
            "reverseComplement": {
              "type": [
                "string",
                "null"
              ]
            },
            "sequenceIndices": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "prevalence": {
              "type": "number"
            },
            "expectedFrequency": {
              "type": "number"
            },
            "expectedMatchingSequences": {
              "type": "number"
            },
            "matchingSequenceProbability": {
              "type": "number"
            },
            "matchingSequenceEValue": {
              "type": [
                "number",
                "null"
              ]
            },
            "matchingSequenceSignificance": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "sequence",
            "sequenceIndices",
            "prevalence",
            "expectedFrequency",
            "expectedMatchingSequences",
            "matchingSequenceProbability"
          ]
        }
      },
      "oligoLength": {
        "type": "integer"
      },
      "strands": {
        "type": "string"
      },
      "sequenceCount": {
        "type": "integer"
      },
      "possiblePositions": {
        "type": "integer"
      },
      "possibleOligos": {
        "type": [
          "number",
          "null"
        ]
      },
      "degenerate": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "motifs",
      "oligoLength",
      "strands",
      "sequenceCount",
      "possiblePositions"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "At least one sequence is required"
    },
    {
      "code": 1001,
      "message": "Invalid DNA sequence"
    },
    {
      "code": 1002,
      "message": "k must be >= 1"
    },
    {
      "code": 1003,
      "message": "minSequences must be >= 1"
    },
    {
      "code": 1004,
      "message": "Background must be 'input', 'equiprobable', 'bernoulli', 'markov' or 'markov_table'"
    },
    {
      "code": 1005,
      "message": "Strands must be 'single' or 'both'"
    },
    {
      "code": 1006,
      "message": "degenerate must be 'none', 'oneN' or 'onedeg'."
    }
  ],
