{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "dyad_analysis",
  "serverName": "Analysis",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "OverrepresentedWordAnalyzer.AnalyzeDyads",
  "docRef": "Seqeron.Genomics.OverrepresentedWords/OverrepresentedWordAnalyzer.DyadAnalysis.cs#L56",
  "description": "RSAT dyad-analysis: over-represented spaced dyads M1 n{s} M2 (two monads of length m separated by s unspecified residues, s in [minSpacing, maxSpacing]) in DNA sequences — any dyad, direct repeats (dr), inverted repeats (ir) or both (rep); expected frequency from the input monad frequencies (or a monad / dyad frequency table), expected occurrences, z-score, and binomial significance occ_P / occ_E / occ_sig over the T_s possible positions. RSAT defaults: m = 3, spacing 0-20, both strands, non-overlapping counts.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequences": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "DNA sequences."
      },
      "monadLength": {
        "type": "integer",
        "minimum": 1,
        "default": 3,
        "description": "Monad length m (RSAT -l, >= 1, default 3)."
      },
      "minSpacing": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Minimal spacing (>= 0, default 0)."
      },
      "maxSpacing": {
        "type": "integer",
        "minimum": 0,
        "default": 20,
        "description": "Maximal spacing (>= minSpacing, default 20)."
      },
      "dyadType": {
        "type": "string",
        "enum": [
          "any",
          "dr",
          "ir",
          "rep"
        ],
        "default": "any",
        "description": "Dyad type: 'any' (default), 'dr' (direct repeats), 'ir' (inverted repeats) or 'rep' (both)."
      },
      "strands": {
        "type": "string",
        "enum": [
          "both",
          "single"
        ],
        "default": "both",
        "description": "Strands: 'both' (-2str, default; reverse-complement pairs) or 'single' (-1str)."
      },
      "countOverlapping": {
        "type": "boolean",
        "default": false,
        "description": "Count overlapping occurrences (-ovlp); default false = RSAT -noov."
      },
      "minCount": {
        "type": "integer",
        "default": 1,
        "description": "Occurrence threshold (RSAT -lth occ, default 1); <= 0 tests every combination of observed monads (RSAT without a threshold)."
      },
      "background": {
        "type": "string",
        "enum": [
          "monads",
          "monad_table",
          "dyad_table"
        ],
        "default": "monads",
        "description": "Background: 'monads' (default, input monad frequencies), 'monad_table' (needs monadFrequencies, RSAT -mncf) or 'dyad_table' (needs dyadFrequencies, RSAT -expfreq)."
      },
      "monadFrequencies": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        },
        "description": "Monad -> expected frequency, for background 'monad_table'."
      },
      "dyadFrequencies": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        },
        "description": "Dyad (RSAT notation, e.g. 'acgn{4}tta') -> expected single-strand frequency, for background 'dyad_table'."
      }
    },
    "required": [
      "sequences"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "dyads": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string"
            },
            "firstMonad": {
              "type": "string"
            },
            "spacing": {
              "type": "integer"
            },
            "secondMonad": {
              "type": "string"
            },
            "reverseComplement": {
              "type": [
                "string",
                "null"
              ]
            },
            "occurrences": {
              "type": "integer"
            },
            "overlaps": {
              "type": "integer"
            },
            "sequenceIndices": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "positions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "observedFrequency": {
              "type": "number"
            },
            "expectedFrequency": {
              "type": [
                "number",
                "null"
              ]
            },
            "expectedOccurrences": {
              "type": [
                "number",
                "null"
              ]
            },
            "expectedVariance": {
              "type": [
                "number",
                "null"
              ]
            },
            "overlapCoefficient": {
              "type": "number"
            },
            "zScore": {
              "type": [
                "number",
                "null"
              ]
            },
            "ratio": {
              "type": "number"
            },
            "occurrenceProbability": {
              "type": [
                "number",
                "null"
              ]
            },
            "occurrenceEValue": {
              "type": [
                "number",
                "null"
              ]
            },
            "occurrenceSignificance": {
              "type": [
                "number",
                "null"
              ]
            },
            "isDirectRepeat": {
              "type": "boolean"
            },
            "isReversePalindrome": {
              "type": "boolean"
            },
            "expectedFromMonads": {
              "type": "boolean"
            }
          },
          "required": [
            "pattern",
            "firstMonad",
            "spacing",
            "secondMonad",
            "reverseComplement",
            "occurrences",
            "overlaps",
            "sequenceIndices",
            "positions",
            "observedFrequency",
            "expectedFrequency",
            "expectedOccurrences",
            "expectedVariance",
            "overlapCoefficient",
            "zScore",
            "ratio",
            "occurrenceProbability",
            "occurrenceEValue",
            "occurrenceSignificance",
            "isDirectRepeat",
            "isReversePalindrome",
            "expectedFromMonads"
          ]
        }
      },
      "monadLength": {
        "type": "integer"
      },
      "minSpacing": {
        "type": "integer"
      },
      "maxSpacing": {
        "type": "integer"
      },
      "dyadType": {
        "type": "string"
      },
      "strands": {
        "type": "string"
      },
      "countOverlapping": {
        "type": "boolean"
      },
      "sequenceCount": {
        "type": "integer"
      },
      "monadOccurrences": {
        "type": "integer"
      },
      "spacings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "spacing": {
              "type": "integer"
            },
            "possiblePositions": {
              "type": "integer"
            },
            "occurrences": {
              "type": "integer"
            },
            "overlaps": {
              "type": "integer"
            }
          },
          "required": [
            "spacing",
            "possiblePositions",
            "occurrences",
            "overlaps"
          ]
        }
      },
      "testedPatterns": {
        "type": "integer"
      },
      "possibleDyads": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "required": [
      "dyads",
      "monadLength",
      "minSpacing",
      "maxSpacing",
      "dyadType",
      "strands",
      "countOverlapping",
      "sequenceCount",
      "monadOccurrences",
      "spacings",
      "testedPatterns",
      "possibleDyads"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "At least one sequence is required"
    },
    {
      "code": 1001,
      "message": "Invalid DNA sequence"
    },
    {
      "code": 1002,
      "message": "monadLength must be >= 1."
    },
    {
      "code": 1002,
      "message": "Spacings must satisfy 0 <= minSpacing <= maxSpacing."
    },
    {
      "code": 1003,
      "message": "dyadType must be 'any', 'dr', 'ir' or 'rep'."
    },
    {
      "code": 1004,
      "message": "Background must be 'monads', 'monad_table' or 'dyad_table'."
    },
    {
      "code": 1005,
      "message": "Background 'monad_table' requires monadFrequencies."
    },
    {
      "code": 1005,
      "message": "Background 'dyad_table' requires dyadFrequencies."
    },
    {
      "code": 1006,
      "message": "Strands must be 'single' or 'both'."
    }
  ],
  "examples": [
    {
      "name": "RSAT dyad-analysis -l 3 -sp 0-2 -lth occ 3 (defaults -2str -noov)",
      "input": {
        "sequences": [
          "ATGCATGCATGCAAATTTGGGCCCATGCTTAGCGGATCCATGCATGCTTTAAACGTACGTAGC"
        ],
        "monadLength": 3,
        "minSpacing": 0,
        "maxSpacing": 2,
        "minCount": 3
      },
      "output": {
        "dyads": [
          {
            "pattern": "CATn{0}GCA",
