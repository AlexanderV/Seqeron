{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "restriction_digest",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RestrictionAnalyzer.Digest",
  "docRef": "Seqeron.Genomics.MolTools/RestrictionAnalyzer.cs#L853",
  "description": "Simulate a restriction digest of a linear or circular molecule and return the ordered fragments with their end overhangs.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "DNA sequence to digest.",
        "minLength": 1
      },
      "enzyme_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "topology": {
        "type": "string",
        "enum": [
          "Linear",
          "Circular"
        ],
        "default": "Linear",
        "description": "Whether the molecule is a linear fragment or a closed circle (plasmid). Circular finds origin-spanning sites and yields k fragments for k cuts instead of k+1."
      }
    },
    "required": [
      "sequence",
      "enzyme_names"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "fragments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "string"
            },
            "startPosition": {
              "type": "integer"
            },
            "length": {
              "type": "integer"
            },
            "leftEnzyme": {
              "type": [
                "string",
                "null"
              ],
              "description": "First name of leftEnzymes (ordinal order), or null when the left end is not a cut."
            },
            "rightEnzyme": {
              "type": [
                "string",
                "null"
              ],
              "description": "First name of rightEnzymes (ordinal order), or null when the right end is not a cut."
            },
            "fragmentNumber": {
              "type": "integer"
            },
            "leftOverhangType": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Blunt",
                "FivePrime",
                "ThreePrime",
                null
              ],
              "description": "End chemistry of the left end, or null when that end was not created by a cut."
            },
            "leftOverhang": {
              "type": [
                "string",
                "null"
              ],
              "description": "Left end's single-stranded extension, 5'-3' on the strand carrying it; empty for a blunt end, null for an uncut end."
            },
            "rightOverhangType": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Blunt",
                "FivePrime",
                "ThreePrime",
                null
              ],
              "description": "End chemistry of the right end, or null when that end was not created by a cut."
            },
            "rightOverhang": {
              "type": [
                "string",
                "null"
              ],
              "description": "Right end's single-stranded extension, 5'-3' on the strand carrying it; empty for a blunt end, null for an uncut end."
            },
            "leftEnzymes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every enzyme whose top-strand cut made the left end (isoschizomers / nested sites cutting at the same position), once each, ordinal order of the table names; empty for an uncut end."
            },
            "rightEnzymes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every enzyme whose top-strand cut made the right end, as leftEnzymes."
            }
          },
          "required": [
            "sequence",
            "startPosition",
            "length",
            "fragmentNumber"
          ]
        }
      }
    },
    "required": [
      "fragments"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "At least one enzyme name is required"
    }
  ],
  "examples": [
    {
      "name": "EcoRI single cut (linear)",
      "input": {
        "sequence": "AAAGAATTCAAA",
        "enzyme_names": [
          "EcoRI"
        ]
      },
      "output": {
        "fragments": [
          {
            "sequence": "AAAG",
            "startPosition": 0,
            "length": 4,
            "rightEnzyme": "EcoRI",
            "rightOverhangType": "FivePrime",
            "rightOverhang": "AATT",
            "leftEnzymes": [],
            "rightEnzymes": [
              "EcoRI"
            ]
          },
          {
            "sequence": "AATTCAAA",
            "startPosition": 4,
            "length": 8,
            "leftEnzyme": "EcoRI",
            "leftOverhangType": "FivePrime",
            "leftOverhang": "AATT",
            "leftEnzymes": [
              "EcoRI"
            ],
            "rightEnzymes": []
          }
        ]
      }
    },
    {
      "name": "EcoRI on a circular molecule with an origin-spanning site",
      "input": {
        "sequence": "TTCAAAAAAAGAA",
        "enzyme_names": [
          "EcoRI"
        ],
        "topology": "Circular"
      },
      "output": {
        "fragments": [
          {
            "sequence": "AATTCAAAAAAAG",
            "startPosition": 11,
            "length": 13,
            "leftEnzyme": "EcoRI",
            "rightEnzyme": "EcoRI",
            "fragmentNumber": 1,
            "leftOverhangType": "FivePrime",
            "leftOverhang": "AATT",
            "rightOverhangType": "FivePrime",
            "rightOverhang": "AATT",
            "leftEnzymes": [
              "EcoRI"
            ],
            "rightEnzymes": [
              "EcoRI"
            ]
          }
        ]
      }
    },
    {
      "name": "No cut site",
      "input": {
        "sequence": "AAAAAAAA",
        "enzyme_names": [
          "EcoRI"
        ]
      },
      "output": {
        "fragments": [
          {
            "sequence": "AAAAAAAA",
            "startPosition": 0,
            "length": 8
          }
        ]
      }
    },
    {
      "name": "Isoschizomers cutting at the same position (MspI + HpaII)",
      "input": {
        "sequence": "CCGGAAACCGG",
        "enzyme_names": [
          "MspI",
          "HpaII"
        ]
      },
      "output": {
        "fragments": [
          {
            "sequence": "C",
            "startPosition": 0,
            "length": 1,
            "rightEnzyme": "HpaII",
            "fragmentNumber": 1,
            "rightOverhangType": "FivePrime",
            "rightOverhang": "CG",
            "leftEnzymes": [],
            "rightEnzymes": [
              "HpaII",
              "MspI"
            ]
          },
          {
            "sequence": "CGGAAAC",
            "startPosition": 1,
            "length": 7,
            "leftEnzyme": "HpaII",
            "rightEnzyme": "HpaII",
            "fragmentNumber": 2,
            "leftOverhangType": "FivePrime",
            "leftOverhang": "CG",
            "rightOverhangType": "FivePrime",
            "rightOverhang": "CG",
            "leftEnzymes": [
              "HpaII",
              "MspI"
            ],
            "rightEnzymes": [
              "HpaII",
              "MspI"
            ]
          },
          {
            "sequence": "CGG",
            "startPosition": 8,
            "length": 3,
            "leftEnzyme": "HpaII",
            "fragmentNumber": 3,
            "leftOverhangType": "FivePrime",
            "leftOverhang": "CG",
            "leftEnzymes": [
              "HpaII",
              "MspI"
            ],
            "rightEnzymes": []
          }
        ]
      }
    }
  ]
}
