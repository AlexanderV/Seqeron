{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "design_molecular_beacon",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "ProbeDesigner.DesignMolecularBeacon",
  "docRef": "Seqeron.Genomics.MolTools/ProbeDesigner.cs#L1915",
  "description": "Design a hairpin molecular-beacon probe (GC-rich complementary stems flanking a target-specific loop) for real-time detection.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "target_sequence": {
        "type": "string",
        "description": "Target DNA sequence.",
        "minLength": 1
      },
      "probe_length": {
        "type": "integer",
        "description": "Loop (target-specific) length in bp (default 25).",
        "minimum": 1,
        "default": 25
      },
      "stem_length": {
        "type": "integer",
        "description": "Stem length in bp (default 5).",
        "minimum": 1,
        "default": 5
      },
      "detection_temperature": {
        "type": [
          "number",
          "null"
        ],
        "description": "Optional detection (annealing) temperature in °C for the Tyagi & Kramer 7–10 °C rules.",
        "default": null
      },
      "max_align_length": {
        "type": "integer",
        "description": "THAL_MAX_ALIGN of the ntthal stem-loop (hairpin) Tm: longest beacon (nt) that gets it (default 60 = Primer3; opt-in 61..10000 = thal.c compiled with -DTHAL_MAX_ALIGN, for beacons longer than 60 nt).",
        "minimum": 60,
        "maximum": 10000,
        "default": 60
      }
    },
    "required": [
      "target_sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "probe": {
        "type": [
          "object",
          "null"
        ],
        "description": "Beacon Probe (Type = MolecularBeacon) or null when the target is too short."
      }
    },
    "required": [
      "probe"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Target sequence cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "Probe (loop) length must be positive"
    },
    {
      "code": 1003,
      "message": "Stem length must be positive"
    }
  ],
  "examples": [
    {
      "name": "48-nt target, 20 bp loop, 5 bp stem",
      "input": {
        "target_sequence": "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT",
        "probe_length": 20,
        "stem_length": 5
      },
      "output": {
        "probe": {
          "sequence": "GGCCCACGTACGTACGTACGTACGTGGGCC",
          "start": 0,
          "end": 19,
          "type": "MolecularBeacon"
        }
      }
    },
    {
      "name": "Too-short target returns null probe",
      "input": {
        "target_sequence": "ACGT",
        "probe_length": 20
      },
      "output": {
        "probe": null
      }
    }
  ]
}
