{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "find_restriction_sites",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RestrictionAnalyzer.FindSites",
  "docRef": "Seqeron.Genomics.MolTools/RestrictionAnalyzer.cs#L438",
  "description": "Find restriction sites for named enzymes (any of the 754 REBASE enzymes with a defined cut, case-insensitive) on both strands of a DNA sequence; 0-based forward-strand coordinates, per-strand cut positions, linear cut-feasibility filter or circular origin-spanning search.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "description": "DNA sequence to scan. IUPAC ambiguity codes are accepted anywhere in the sequence (N, R, Y, ...), so an N-containing contig or a soft-masked assembly can be scanned as it is: a site N matches any of the 15 IUPAC codes, every other site code matches only a concrete A/C/G/T base it expands to, and a character outside the 15 codes matches nothing — Biopython's own rule.",
        "type": "string"
      },
      "enzyme_names": {
        "description": "Names of restriction enzymes to look for.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "topology": {
        "description": "Linear (default) or Circular: whether the molecule is a linear fragment or a closed circle (plasmid).",
        "type": "string",
        "enum": [
          "Linear",
          "Circular"
        ],
        "default": "Linear"
      },
      "methylation": {
        "description": "Optional methylation-aware recognition (EMBOSS restrict -methylation semantics): \"none\" (default), \"dam\" (GmATC), \"dcm\" (mCmCAGG, mCmCTGG), \"dam+dcm\" or \"emboss\" (all five Emethylsites.dat entries incl. EcoKI). Case-insensitive. A recognition window containing a methylated base is NOT a site (a window rule, not an enzyme-specific sensitivity table; BamHI is blocked by Dam).",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "sequence",
      "enzyme_names"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "sites": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "position": {
              "type": "integer"
            },
            "isForwardStrand": {
              "type": "boolean"
            },
            "cutPosition": {
              "type": "integer"
            },
            "recognizedSequence": {
              "type": "string"
            }
          },
          "required": [
            "position",
            "isForwardStrand",
            "cutPosition",
            "recognizedSequence"
          ]
        }
      }
    },
    "required": [
      "sites"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "At least one enzyme name is required"
    },
    {
      "code": 4001,
      "message": "Unknown enzyme name"
    }
  ],
  "examples": [
    {
      "name": "EcoRI site",
      "input": {
        "sequence": "AAAGAATTCAAA",
        "enzyme_names": [
          "EcoRI"
        ]
      },
      "output": {
        "sites": [
          {
            "position": 3,
            "isForwardStrand": true,
            "cutPosition": 4,
            "recognizedSequence": "GAATTC"
          },
          {
            "position": 3,
            "isForwardStrand": false,
            "cutPosition": 8,
            "recognizedSequence": "GAATTC"
          }
        ]
      }
    },
    {
      "name": "No site",
      "input": {
        "sequence": "AAAAAAAA",
        "enzyme_names": [
          "EcoRI"
        ]
      },
      "output": {
        "sites": []
      }
    },
    {
      "name": "Circular plasmid, origin-spanning site",
      "input": {
        "sequence": "TTCAAAAAAAGAA",
        "enzyme_names": [
          "EcoRI"
        ],
        "topology": "Circular"
      },
      "output": {
        "sites": [
          {
            "position": 10,
            "isForwardStrand": true,
            "cutPosition": 11,
            "recognizedSequence": "GAATTC"
          },
          {
            "position": 10,
            "isForwardStrand": false,
            "cutPosition": 2,
            "recognizedSequence": "GAATTC"
          }
        ]
      }
    },
    {
      "name": "Linear cut feasibility — Sau3AI edge sites are not cuttable",
      "input": {
        "sequence": "GATCGATCGATC",
        "enzyme_names": [
          "Sau3AI"
        ]
      },
      "output": {
        "sites": [
          {
            "position": 4,
            "isForwardStrand": true,
            "cutPosition": 4,
            "recognizedSequence": "GATC"
          },
          {
            "position": 4,
            "isForwardStrand": false,
            "cutPosition": 8,
            "recognizedSequence": "GATC"
          }
        ]
      }
    }
  ]
}
