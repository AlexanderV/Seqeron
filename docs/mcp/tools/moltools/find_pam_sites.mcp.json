{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "find_pam_sites",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "CrisprDesigner.FindPamSites",
  "docRef": "Seqeron.Genomics.MolTools/CrisprDesigner.cs#L52",
  "description": "Find all PAM matches (both strands) for a CRISPR system in a DNA sequence.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": { "type": "string", "description": "DNA sequence to scan: A, C, G, T or N, in either case. Any other character (U, an IUPAC code other than N, a space, a trailing newline, a FASTA header line) is rejected with the character and its index.", "minLength": 1 },
      "system_type": { "type": "string", "enum": ["SpCas9", "SpCas9_NAG", "SpCas9_NGA", "SaCas9", "SaCas9_NNGRRN", "Cas12a", "AsCas12a", "LbCas12a", "CasX"], "description": "CRISPR system (default SpCas9).", "default": "SpCas9" }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "sites": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "position": { "type": "integer" },
            "pamSequence": { "type": "string" },
            "targetSequence": { "type": "string" },
            "targetStart": { "type": "integer" },
            "isForwardStrand": { "type": "boolean" },
            "system": {
            "type": "object",
            "description": "The CRISPR system record (see crispr_system_info).",
            "properties": {
              "name": { "type": "string" },
              "pamSequence": { "type": "string" },
              "guideLength": { "type": "integer" },
              "pamAfterTarget": { "type": "boolean" },
              "description": { "type": "string" },
              "cutOffset": { "type": "integer" }
            },
            "required": ["name", "pamSequence", "guideLength", "pamAfterTarget", "description", "cutOffset"]
          }
          },
          "required": ["position", "pamSequence", "targetSequence", "targetStart", "isForwardStrand", "system"]
        }
      }
    },
    "required": ["sites"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" },
    { "code": 1002, "message": "Expected A/C/G/T/N but found '{char}' at index {i}." }
  ],
  "examples": [
    {
      "name": "SpCas9 NGG site",
      "input": { "sequence": "ATATATATATATATATATATTGG", "system_type": "SpCas9" },
      "output": { "sites": [ { "position": 20, "pamSequence": "TGG", "targetSequence": "ATATATATATATATATATAT", "targetStart": 0, "isForwardStrand": true } ] }
    },
    {
      "name": "Too short",
      "input": { "sequence": "TGG", "system_type": "SpCas9" },
      "output": { "sites": [] }
    }
  ]
}
