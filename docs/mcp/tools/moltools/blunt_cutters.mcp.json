{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "blunt_cutters",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RestrictionAnalyzer.GetBluntCutters",
  "docRef": "Seqeron.Genomics.MolTools/RestrictionAnalyzer.cs#L162",
  "description": "List the restriction enzymes of enzyme_set (\"common\" = 39 by default, \"rebase\" = all 754 REBASE enzymes with a defined cut) that produce blunt ends (both strands cut at the same position; Biopython is_blunt).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "enzyme_set": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "common",
          "rebase",
          null
        ],
        "default": "common",
        "description": "Which enzyme table to list from: \"common\" (default; the 39 common laboratory enzymes) or \"rebase\" (all 754 REBASE enzymes with a defined cut, the 39 included). Case-insensitive."
      }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "enzymes": {
        "type": "array",
        "description": "Blunt-cutting restriction enzymes.",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Enzyme name."
            },
            "recognitionSequence": {
              "type": "string",
              "description": "Recognition sequence (IUPAC)."
            },
            "cutPositionForward": {
              "type": "integer",
              "description": "Cut offset on the forward strand (Biopython fst5)."
            },
            "cutPositionReverse": {
              "type": "integer",
              "description": "Cut offset on the reverse strand (Biopython size + fst3)."
            },
            "organism": {
              "type": "string",
              "description": "Source organism."
            },
            "secondCutForward": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Two-sided (Type IIB) cutters only: top-strand offset of the second cut pair (Biopython scd5; BaeI 23). Omitted/null for a one-cut enzyme."
            },
            "secondCutReverse": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Two-sided (Type IIB) cutters only: bottom-strand offset of the second cut pair (Biopython size + scd3; BaeI 18). Omitted/null for a one-cut enzyme."
            },
            "isBluntEnd": {
              "type": "boolean",
              "description": "True when both strands are cut at the same offset (Biopython is_blunt)."
            },
            "overhangType": {
              "type": "string",
              "enum": [
                "Blunt",
                "FivePrime",
                "ThreePrime"
              ],
              "description": "End chemistry: the sign of Biopython ovhg."
            },
            "recognitionLength": {
              "type": "integer",
              "description": "Length of the full recognition string (Biopython size); SfiI is 13."
            },
            "rebaseMethylationField": {
              "type": "string",
              "description": "REBASE allenz.104 field <6> (METHYLATION SITE) verbatim, e.g. \"3(6)\" for EcoRI; \"\" when REBASE records none. The site the enzyme's COGNATE methyltransferase modifies, not Dam/Dcm/CpG sensitivity."
            },
            "cognateMethylationSites": {
              "type": "array",
              "description": "Typed parse of rebaseMethylationField.",
              "items": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "1-based position of the modified base in the recognition sequence, counted from the 5' end of the named strand; null for REBASE '?'."
                  },
                  "isComplementaryStrand": {
                    "type": "boolean",
                    "description": "True for a REBASE negative position (complementary strand)."
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "N4Methylcytosine",
                      "C5Methylcytosine",
                      "N6Methyladenine"
                    ],
                    "description": "REBASE (4) / (5) / (6)."
                  }
                }
              }
            }
          },
          "required": [
            "name",
            "recognitionSequence",
            "cutPositionForward",
            "cutPositionReverse",
            "organism",
            "isBluntEnd",
            "overhangType",
            "recognitionLength"
          ]
        }
      }
    },
    "required": [
      "enzymes"
    ]
  },
  "errors": [
    {
      "code": 1010,
      "message": "Unknown enzyme set '<value>'; expected \"common\" or \"rebase\""
    }
  ],
  "examples": [
    {
      "name": "List blunt cutters",
      "input": {},
      "output": {
        "enzymes": [
          {
            "name": "SwaI",
            "recognitionSequence": "ATTTAAAT",
            "cutPositionForward": 4,
            "cutPositionReverse": 4,
            "organism": "Staphylococcus warneri",
            "isBluntEnd": true,
            "overhangType": "Blunt",
            "recognitionLength": 8
          },
          {
            "name": "AluI",
            "recognitionSequence": "AGCT",
            "cutPositionForward": 2,
            "cutPositionReverse": 2,
            "organism": "Arthrobacter luteus",
            "isBluntEnd": true,
            "overhangType": "Blunt",
            "recognitionLength": 4
          }
        ]
      }
    },
    {
      "name": "Blunt cutter count",
      "input": {},
      "output": {
        "enzymes": "10 enzymes: SwaI, AluI, RsaI, HaeIII, DpnI, EcoRV, SmaI, HincII, ScaI, StuI"
      }
    },
    {
      "name": "Blunt cutters of the REBASE set",
      "input": {
        "enzyme_set": "rebase"
      },
      "output": {
        "enzymes": "137 enzymes (Biopython is_blunt over the 754): AanI, Acc16I, AccBSI, AccII, AcvI, AfaI, AfeI, AhaIII, ..."
      }
    },
    {
      "name": "Unknown enzyme set",
      "input": {
        "enzyme_set": "all"
      },
      "output": {
        "error": "Unknown enzyme set 'all'; expected \"common\" or \"rebase\"."
      }
    }
  ]
}
