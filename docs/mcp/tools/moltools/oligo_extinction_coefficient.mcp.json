{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "oligo_extinction_coefficient",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "ProbeDesigner.CalculateExtinctionCoefficient",
  "docRef": "Seqeron.Genomics.MolTools/ProbeDesigner.cs#L3574",
  "description": "Molar extinction coefficient at 260 nm: per-base sum (default) or the nearest-neighbour model (Cantor, Warshaw & Shapiro 1970 DNA / Warshaw & Tinoco 1966 RNA).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "Oligonucleotide sequence.",
        "minLength": 1
      },
      "nearest_neighbor": {
        "type": "boolean",
        "description": "Use the nearest-neighbour model (default false = mononucleotide sum).",
        "default": false
      },
      "is_dna": {
        "type": "boolean",
        "description": "For nearest_neighbor: true = DNA table (A/C/G/T), false = RNA table (A/C/G/U) (default true).",
        "default": true
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "extinctionCoefficient": {
        "type": "number",
        "description": "Molar extinction coefficient at 260 nm (M^-1 cm^-1)."
      }
    },
    "required": [
      "extinctionCoefficient"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1001,
      "message": "Nearest-neighbour ε260 needs only A/C/G/T (DNA) or A/C/G/U (RNA) bases"
    }
  ],
  "examples": [
    {
      "name": "ACGT",
      "input": {
        "sequence": "ACGT"
      },
      "output": {
        "extinctionCoefficient": 43000
      }
    },
    {
      "name": "Unknown base fallback",
      "input": {
        "sequence": "N"
      },
      "output": {
        "extinctionCoefficient": 10000
      }
    },
    {
      "name": "Nearest-neighbour DNA",
      "input": {
        "sequence": "ACGT",
        "nearest_neighbor": true
      },
      "output": {
        "extinctionCoefficient": 40300
      }
    }
  ]
}
