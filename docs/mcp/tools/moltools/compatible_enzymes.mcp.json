{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "compatible_enzymes",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RestrictionAnalyzer.FindCompatibleEnzymes",
  "docRef": "Seqeron.Genomics.MolTools/RestrictionAnalyzer.cs#L1206",
  "description": "Enumerate pairs of built-in restriction enzymes that produce ligatable (compatible) ends, or - with enzyme_name - the enzymes one enzyme's end can be ligated to, itself included.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "enzyme_name": {
        "type": [
          "string",
          "null"
        ],
        "description": "Restrict the result to pairs involving this enzyme (case-insensitive, itself included). Omit or leave blank for every pair in the table."
      }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "pairs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "enzyme1": {
              "type": "string"
            },
            "enzyme2": {
              "type": "string"
            },
            "compatibleEnd": {
              "type": "string",
              "description": "\"blunt\" or the shared overhang sequence."
            }
          },
          "required": [
            "enzyme1",
            "enzyme2",
            "compatibleEnd"
          ]
        }
      }
    },
    "required": [
      "pairs"
    ]
  },
  "errors": [
    {
      "code": 1003,
      "message": "Unknown enzyme: <name> (only when enzyme_name is given)"
    }
  ],
  "examples": [
    {
      "name": "GATC-compatible sticky pair",
      "input": {},
      "output": {
        "pairs": [
          {
            "enzyme1": "BamHI",
            "enzyme2": "BglII",
            "compatibleEnd": "GATC"
          }
        ]
      }
    },
    {
      "name": "Complete listing",
      "input": {},
      "output": {
        "pairs": "64 pairs: 45 \"blunt\" (all C(10,2) blunt-cutter pairs), 6 \"GATC\", 6 \"CTAG\", 6 \"CG\", 1 \"TCGA\""
      }
    },
    {
      "name": "Per-enzyme query",
      "input": {
        "enzyme_name": "BamHI"
      },
      "output": {
        "pairs": [
          {
            "enzyme1": "BamHI",
            "enzyme2": "BamHI",
            "compatibleEnd": "GATC"
          },
          {
            "enzyme1": "BamHI",
            "enzyme2": "BglII",
            "compatibleEnd": "GATC"
          },
          {
            "enzyme1": "BamHI",
            "enzyme2": "Sau3AI",
            "compatibleEnd": "GATC"
          },
          {
            "enzyme1": "BamHI",
            "enzyme2": "MboI",
            "compatibleEnd": "GATC"
          }
        ]
      }
    },
    {
      "name": "Unique overhang - compatible with itself only",
      "input": {
        "enzyme_name": "SfiI"
      },
      "output": {
        "pairs": [
          {
            "enzyme1": "SfiI",
            "enzyme2": "SfiI",
            "compatibleEnd": "NNN"
          }
        ]
      }
    }
  ]
}
