{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "enzymes_compatible",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RestrictionAnalyzer.AreCompatible",
  "docRef": "Seqeron.Genomics.MolTools/RestrictionAnalyzer.cs#L1271",
  "description": "Return whether two named built-in restriction enzymes produce ligatable (compatible) ends: both blunt, or the same overhang polarity with overhangs that can anneal. An unknown name is an error.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "enzyme1_name": {
        "type": "string",
        "description": "First enzyme name.",
        "minLength": 1
      },
      "enzyme2_name": {
        "type": "string",
        "description": "Second enzyme name.",
        "minLength": 1
      }
    },
    "required": [
      "enzyme1_name",
      "enzyme2_name"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "compatible": {
        "type": "boolean",
        "description": "True if the two enzymes produce ligatable ends."
      },
      "compatibleEnd": {
        "type": [
          "string",
          "null"
        ],
        "description": "The shared end - \"blunt\" or the overhang sequence - or null when incompatible."
      }
    },
    "required": [
      "compatible"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "First enzyme name cannot be null or blank"
    },
    {
      "code": 1002,
      "message": "Second enzyme name cannot be null or blank"
    },
    {
      "code": 1003,
      "message": "Unknown enzyme: <name>"
    }
  ],
  "examples": [
    {
      "name": "Two blunt cutters",
      "input": {
        "enzyme1_name": "EcoRV",
        "enzyme2_name": "SmaI"
      },
      "output": {
        "compatible": true,
        "compatibleEnd": "blunt"
      }
    },
    {
      "name": "Same 5' GATC overhang",
      "input": {
        "enzyme1_name": "BamHI",
        "enzyme2_name": "BglII"
      },
      "output": {
        "compatible": true,
        "compatibleEnd": "GATC"
      }
    },
    {
      "name": "Different overhangs",
      "input": {
        "enzyme1_name": "EcoRI",
        "enzyme2_name": "BamHI"
      },
      "output": {
        "compatible": false,
        "compatibleEnd": null
      }
    },
    {
      "name": "Same letters, opposite polarity - NOT compatible",
      "input": {
        "enzyme1_name": "HindIII",
        "enzyme2_name": "SacI"
      },
      "output": {
        "compatible": false,
        "compatibleEnd": null
      }
    },
    {
      "name": "Different overhang length",
      "input": {
        "enzyme1_name": "SfiI",
        "enzyme2_name": "PstI"
      },
      "output": {
        "compatible": false,
        "compatibleEnd": null
      }
    },
    {
      "name": "Unknown enzyme is an error",
      "input": {
        "enzyme1_name": "EcoRI",
        "enzyme2_name": "NotAnEnzyme"
      },
      "output": {
        "error": {
          "code": 1003,
          "message": "Unknown enzyme: NotAnEnzyme"
        }
      }
    }
  ]
}
