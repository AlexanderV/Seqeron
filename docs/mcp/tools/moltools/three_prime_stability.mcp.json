{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "three_prime_stability",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "PrimerDesigner.Calculate3PrimeStability",
  "docRef": "Seqeron.Genomics.MolTools/PrimerDesigner.cs#L2263 (Calculate3PrimeStability)",
  "description": "Primer3 end_oligodg: SantaLucia (1998) nearest-neighbor delta-G 37C of a primer's last 5 bases (Primer3 PRIMER_*_END_STABILITY with opposite sign).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "Primer sequence.",
        "minLength": 1
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "deltaG": {
        "type": "number",
        "description": "3' end delta-G 37C in kcal/mol of the last 5 bases (whole primer if shorter; = -Primer3 END_STABILITY; more negative = more stable)."
      }
    },
    "required": [
      "deltaG"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "The 3'-terminal 5 bases may contain only A, C, G, T or N"
    }
  ],
  "examples": [
    {
      "name": "GC-rich 3' end",
      "input": {
        "sequence": "GCGCG"
      },
      "output": {
        "deltaG": -6.86
      }
    },
    {
      "name": "AT-rich 3' end",
      "input": {
        "sequence": "TATAT"
      },
      "output": {
        "deltaG": -0.86
      }
    }
  ]
}
