{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "crispr_specificity_score",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "CrisprDesigner.CalculateHeuristicSpecificityScore",
  "docRef": "Seqeron.Genomics.MolTools/CrisprDesigner.cs#L1086",
  "description": "THIS LIBRARY'S OWN HEURISTIC, NOT A PUBLISHED MODEL: aggregates off-target hits (<=4 mismatches) as max(0, 100 - sum(5 per seed mismatch + 2 per distal mismatch)). For the published models use crispr_mit_specificity_score or crispr_cfd_specificity_score.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "guide_sequence": { "type": "string", "description": "Guide RNA sequence (length must match the system's guide length).", "minLength": 1 },
      "genome": { "type": "string", "description": "Genome / reference sequence to scan.", "minLength": 1 },
      "system_type": { "type": "string", "enum": ["SpCas9", "SpCas9_NAG", "SpCas9_NGA", "SaCas9", "SaCas9_NNGRRN", "Cas12a", "AsCas12a", "LbCas12a", "CasX"], "description": "CRISPR system (default SpCas9).", "default": "SpCas9" }
    },
    "required": ["guide_sequence", "genome"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "specificity": { "type": "number", "description": "Heuristic specificity score 0..100 (100 = no off-targets)." }
    },
    "required": ["specificity"]
  },
  "errors": [
    { "code": 1001, "message": "Guide sequence cannot be null or empty" },
    { "code": 1002, "message": "Genome cannot be null or empty" },
    { "code": 4001, "message": "Guide length does not match the system's guide length" }
  ],
  "examples": [
    {
      "name": "Unique guide -> 100",
      "input": { "guide_sequence": "ATATATATATATATATATAT", "genome": "ATATATATATATATATATATAGG" },
      "output": { "specificity": 100.0 }
    },
    {
      "name": "Wrong guide length errors",
      "input": { "guide_sequence": "ACGT", "genome": "ATATATATATATATATATATAGG" },
      "output": { "error": "Guide length (4) does not match expected length (20) for SpCas9." }
    }
  ]
}
