{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "reduce_secondary_structure",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "CodonOptimizer.ReduceSecondaryStructure",
  "docRef": "Seqeron.Genomics.MolTools/CodonOptimizer.cs#L990",
  "description": "Greedy synonymous-codon swap that lowers a window structure score to reduce mRNA secondary structure; scoring is either the local self-complementarity heuristic (canonical pairing incl. G·U wobble, default) or the Turner 2004 nearest-neighbour window MFE; RNA-normalised output.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "coding_sequence": { "type": "string", "description": "Coding sequence (DNA or RNA).", "minLength": 1 },
      "target_organism": { "type": "object", "description": "Preset id or inline custom table." },
      "window_size": { "type": "integer", "description": "Sliding-window size (nt).", "minimum": 1, "default": 40 },
      "scoring": { "type": "string", "description": "Window scoring model: PairCount (default, canonical-pair fraction heuristic) or Turner2004Mfe (Turner 2004 nearest-neighbour free energy; thermodynamic but much slower).", "enum": ["PairCount", "Turner2004Mfe"], "default": "PairCount" }
    },
    "required": ["coding_sequence", "target_organism"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "optimizedSequence": { "type": "string", "description": "Sequence with reduced local self-complementarity." }
    },
    "required": ["optimizedSequence"]
  },
  "errors": [
    { "code": 1001, "message": "Coding sequence cannot be null or empty" },
    { "code": 1002, "message": "Window size must be positive" },
    { "code": 1003, "message": "Unknown secondary-structure scoring" }
  ],
  "examples": [
    {
      "name": "Below window -> unchanged",
      "input": { "coding_sequence": "ATGATG", "target_organism": { "preset": "EColiK12" }, "window_size": 40 },
      "output": { "optimizedSequence": "ATGATG" }
    },
    {
      "name": "Processed sequence keeps length",
      "input": { "coding_sequence": "GCGGCGGCGGCGGCGGCGGCGGCGGCGGCGGCGGCGGCGGCGGCG", "target_organism": { "preset": "EColiK12" }, "window_size": 40 },
      "output": { "optimizedSequence": "same length (45 nt), protein preserved" }
    },
    {
      "name": "Turner 2004 MFE scoring",
      "input": { "coding_sequence": "AUGAAACUGGCAGAUCUGGCGCAGCUGGCAUUUCGUGAAGAUCUGCGUCAGGCGCUGGAUCGUUUCAUGGCGCAGCUGGAUAAAGCGCUGGCGGAAUAA", "target_organism": { "preset": "EColiK12" }, "scoring": "Turner2004Mfe" },
      "output": { "optimizedSequence": "AUGAAGCUGGCAGAUCUUGCUCAACUUGCAUUUCGUGAAGACCUUCGGCAAGCUUUAGAUCGUUUCAUGGCACAAUUAGAUAAAGCAUUAGCAGAAUAA" }
    }
  ]
}
