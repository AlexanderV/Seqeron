{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "crispr_system_info",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "CrisprDesigner.GetSystem",
  "docRef": "Seqeron.Genomics.MolTools/CrisprDesigner.cs#L26",
  "description": "Return the metadata (PAM, guide length, PAM placement, cut offset) for a known CRISPR nuclease system.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "system_type": { "type": "string", "enum": ["SpCas9", "SpCas9_NAG", "SpCas9_NGA", "SaCas9", "SaCas9_NNGRRN", "Cas12a", "AsCas12a", "LbCas12a", "CasX"], "description": "CRISPR system: SpCas9 | SpCas9_NAG | SpCas9_NGA | SaCas9 | SaCas9_NNGRRN | Cas12a | AsCas12a | LbCas12a | CasX." }
    },
    "required": ["system_type"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "name": { "type": "string" },
      "pamSequence": { "type": "string", "description": "PAM recognition sequence (IUPAC)." },
      "guideLength": { "type": "integer", "description": "Guide/spacer length in nt." },
      "pamAfterTarget": { "type": "boolean", "description": "True if PAM is 3' of the target (Cas9-like); false if 5' (Cas12a-like)." },
      "description": { "type": "string" },
      "cutOffset": { "type": "integer", "description": "Nucleotides between the PAM and the cut on the PAM-bearing strand (3 for the Cas9 systems, 18 for Cas12a, 13 for CasX)." }
    },
    "required": ["name", "pamSequence", "guideLength", "pamAfterTarget", "description", "cutOffset"]
  },
  "errors": [
    { "code": 1001, "message": "Unknown CRISPR system: {system_type} (not one of the nine listed values)" }
  ],
  "examples": [
    {
      "name": "SpCas9",
      "input": { "system_type": "SpCas9" },
      "output": { "name": "SpCas9", "pamSequence": "NGG", "guideLength": 20, "pamAfterTarget": true, "description": "Streptococcus pyogenes Cas9", "cutOffset": 3 }
    },
    {
      "name": "Cas12a",
      "input": { "system_type": "Cas12a" },
      "output": { "name": "Cas12a/Cpf1", "pamSequence": "TTTV", "guideLength": 23, "pamAfterTarget": false, "description": "Cas12a (Cpf1) - PAM before target", "cutOffset": 18 }
    }
  ]
}
