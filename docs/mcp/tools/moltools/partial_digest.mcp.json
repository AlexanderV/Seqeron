              "rightOverhang": "CG",
              "leftEnzymes": [
                "Sau3AI"
              ],
              "rightEnzymes": [
                "TaqI"
              ]
            },
            "missedCuts": 0
          },
          {
            "fragment": {
              "sequence": "CGA",
