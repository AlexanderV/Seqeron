              "rightOverhangType": "Blunt",
              "rightOverhang": "",
              "leftEnzymes": [],
              "rightEnzymes": [
                "AluI"
              ]
            },
            "missedCuts": 0
          },
          {
            "fragment": {
              "sequence": "CT",
              "startPosition": 2,
              "length": 2,
              "leftEnzyme": "AluI",
              "rightEnzyme": "Sau3AI",
              "fragmentNumber": 2,
              "leftOverhangType": "Blunt",
              "leftOverhang": "",
              "rightOverhangType": "FivePrime",
              "rightOverhang": "GATC",
