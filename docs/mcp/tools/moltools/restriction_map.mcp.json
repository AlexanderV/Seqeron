{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "restriction_map",
  "serverName": "MolTools",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "RestrictionAnalyzer.CreateMap",
  "docRef": "Seqeron.Genomics.MolTools/RestrictionAnalyzer.cs#L1344",
  "description": "Build a restriction map: sites, sites-by-enzyme, unique cutters and non-cutters. Named enzymes may be any of the 754 REBASE enzymes with a defined cut; with no names, enzyme_set picks the considered table (\"common\" = 39 by default, \"rebase\" = 754). sitesByEnzyme and nonCutters partition the considered enzyme set, keyed by canonical enzyme name.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": { "type": "string", "description": "DNA sequence to map.", "minLength": 1 },
      "enzyme_names": { "type": "array", "items": { "type": "string" }, "description": "Enzymes to consider (case-insensitive, de-duplicated; any of the 754 REBASE enzymes with a defined cut); empty = every enzyme of enzyme_set." },
      "topology": { "type": "string", "enum": ["Linear", "Circular"], "default": "Linear", "description": "Whether the molecule is a linear fragment or a closed circle (plasmid)." },
      "enzyme_set": { "type": ["string", "null"], "enum": ["common", "rebase", null], "default": "common", "description": "Enzyme table used when enzyme_names is empty: \"common\" (default; the 39 common laboratory enzymes) or \"rebase\" (all 754 REBASE enzymes with a defined cut). Case-insensitive; ignored when names are given." }
    },
    "required": ["sequence", "enzyme_names"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "sequenceLength": { "type": "integer" },
      "sites": { "type": "array", "items": { "type": "object" } },
      "sitesByEnzyme": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "integer" } } },
      "totalSites": { "type": "integer", "description": "Forward-strand site count." },
      "uniqueCutters": { "type": "array", "items": { "type": "string" } },
      "nonCutters": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["sequenceLength", "sites", "sitesByEnzyme", "totalSites", "uniqueCutters", "nonCutters"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" },
    { "code": 1010, "message": "Unknown enzyme set '<value>'; expected \"common\" or \"rebase\"" }
  ],
  "examples": [
    {
      "name": "EcoRI unique cutter, BamHI non-cutter",
      "input": { "sequence": "AAAGAATTCAAA", "enzyme_names": ["EcoRI", "BamHI"] },
      "output": { "sequenceLength": 12, "sitesByEnzyme": { "EcoRI": [3, 3] }, "totalSites": 1, "uniqueCutters": ["EcoRI"], "nonCutters": ["BamHI"] }
    },
    {
      "name": "All enzymes",
      "input": { "sequence": "AAAGAATTCAAA", "enzyme_names": [] },
      "output": { "sequenceLength": 12, "totalSites": 1, "uniqueCutters": ["EcoRI"] }
    },
    {
      "name": "All REBASE enzymes (no names, enzyme_set rebase)",
      "input": { "sequence": "AAGGTCTCAAAAAAAAAAAAAAAGAGACCAAAAAAAAAAA", "enzyme_names": [], "enzyme_set": "rebase" },
      "output": { "sequenceLength": 40, "totalSites": 41, "uniqueCutters": ["SetI"], "sitesByEnzyme": "14 enzymes, e.g. BsaI: [2, 23]", "nonCutters": "740 enzymes (14 + 740 = 754)" }
    },
    {
      "name": "Unknown enzyme set",
      "input": { "sequence": "GAATTC", "enzyme_names": [], "enzyme_set": "all" },
      "output": { "error": "Unknown enzyme set 'all'; expected \"common\" or \"rebase\"." }
    }
  ]
}
