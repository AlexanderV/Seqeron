{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "find_branch_points",
  "serverName": "Annotation",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SpliceSitePredictor.FindBranchPoints",
  "docRef": "Seqeron.Genomics.Annotation/SpliceSitePredictor.cs#L768",
  "description": "Find branch-point candidates: human yUnAy (Gao et al. 2008; conservation-weighted match of y@-3, U@-2, A@0, y@+1, score [0,1]) or yeast UACUAAC (match fraction). Position = index of the branch adenosine position; motifs with non-ACGTU characters are skipped.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": {
        "type": "string",
        "description": "RNA/DNA sequence to scan",
        "minLength": 1
      },
      "searchStart": {
        "type": "integer",
        "description": "Smallest motif start index scanned (inclusive)",
        "default": 0
      },
      "searchEnd": {
        "type": "integer",
        "description": "Largest motif start index scanned (inclusive); -1 scans to the end",
        "default": -1
      },
      "minScore": {
        "type": "number",
        "description": "Minimum score [0,1]",
        "default": 0.5
      },
      "model": {
        "type": "string",
        "enum": [
          "human",
          "yeast"
        ],
        "description": "Branch-point consensus: human yUnAy or yeast UACUAAC",
        "default": "human"
      }
    },
    "required": [
      "sequence"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "sites": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "position": {
              "type": "integer",
              "description": "0-based index of the branch adenosine (window start + 5)"
            },
            "type": {
              "type": "string",
              "description": "Branch"
            },
            "motif": {
              "type": "string",
              "description": "7-mer at the window start"
            },
            "score": {
              "type": "number"
            },
            "confidence": {
              "type": "number"
            }
          },
          "required": [
            "position",
            "type",
            "motif",
            "score",
            "confidence"
          ]
        }
      }
    },
    "required": [
      "sites"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Sequence cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "Unknown model '...'; expected 'human' or 'yeast'."
    }
  ],
  "examples": [
    {
      "name": "Human yUnAy",
      "input": {
        "sequence": "GGGGGUACUAACGGGGGUUUUUCAGG",
        "minScore": 0.75
      },
      "output": {
        "sites": [
          {
            "position": 10,
            "type": "Branch",
            "motif": "CUAAC",
            "score": 1.0
          },
          {
            "position": 23,
            "type": "Branch",
            "motif": "UUCAG",
            "score": 0.7660436137071651
          }
        ]
      }
    },
    {
      "name": "Yeast UACUAAC",
      "input": {
        "sequence": "GGGGGUACUAACGGGGGUUUUUCAGG",
        "minScore": 0.75,
        "model": "yeast"
      },
      "output": {
        "sites": [
          {
            "position": 10,
            "type": "Branch",
            "motif": "UACUAAC",
            "score": 1.0
          }
        ]
      }
    },
    {
      "name": "Too short",
      "input": {
        "sequence": "AUCG",
        "minScore": 0.0
      },
      "output": {
        "sites": []
      }
    }
  ]
}
