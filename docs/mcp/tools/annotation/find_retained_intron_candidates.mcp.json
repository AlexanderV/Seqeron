{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "find_retained_intron_candidates",
  "serverName": "Annotation",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SpliceSitePredictor.FindRetainedIntronCandidates",
  "docRef": "Seqeron.Genomics.Annotation/SpliceSitePredictor.cs#L905",
  "description": "Find retained-intron candidates by sequence-level features (open reading frame; optional length, weak-site and GC filters).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": { "type": "string", "description": "RNA/DNA sequence to analyze", "minLength": 1 },
      "minScore": { "type": "number", "description": "Minimum combined intron score", "default": 0.5 },
      "maxIntronLength": { "type": "integer", "description": "Optional maximum intron length (nt)" },
      "maxIntronScore": { "type": "number", "description": "Optional: keep only introns with combined score below this (weak sites)" },
      "minGcFraction": { "type": "number", "description": "Optional minimum G+C fraction (0-1)" },
      "requireOpenReadingFrame": { "type": "boolean", "description": "No in-frame stop in some phase", "default": true },
      "requireLengthMultipleOf3": { "type": "boolean", "description": "Intron length divisible by 3", "default": true }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "introns": {
        "type": "array",
        "items": { "type": "object", "description": "Intron satisfying the criteria" }
      }
    },
    "required": ["introns"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" }
  ],
  "examples": [
    {
      "name": "Frame-compatible intron",
      "input": { "sequence": "<exon1>GUAAGU<60xA><14xU>CAG<exon2>", "minScore": 0.2 },
      "output": { "introns": [ { "type": "U2" } ] }
    },
    {
      "name": "No introns present",
      "input": { "sequence": "AACCAACCAACCAACCAACCAACCAACCAACCAACCAACCAACCAACCAA", "minScore": 0.2 },
      "output": { "introns": [] }
    }
  ]
}
