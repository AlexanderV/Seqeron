{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "find_pre_mirna_hairpins",
  "serverName": "Annotation",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "MiRnaAnalyzer.FindPreMiRnaHairpins",
  "docRef": "Seqeron.Genomics.Annotation/MiRnaAnalyzer.cs#L2549",
  "description": "Identify pre-miRNA hairpin candidates: default MFE-fold detection (~20 ms per window; Turner 2004) or, for long inputs, the fast consecutive-pairing screen (useConsecutiveScreen=true).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "sequence": { "type": "string", "description": "Nucleotide sequence to scan", "minLength": 1 },
      "minHairpinLength": { "type": "integer", "description": "Minimum hairpin length (nt)", "default": 55 },
      "maxHairpinLength": { "type": "integer", "description": "Maximum hairpin length (nt)", "default": 120 },
      "matureLength": { "type": "integer", "description": "Mature miRNA length (nt)", "default": 22 },
      "useConsecutiveScreen": { "type": "boolean", "description": "false (default) = MFE-fold detection; true = fast consecutive-pairing screen for long inputs (no bulges)", "default": false },
      "minMfei": { "type": "number", "description": "MFEI threshold of the default mode (Zhang 2006); ignored when useConsecutiveScreen=true", "default": 0.85 }
    },
    "required": ["sequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "hairpins": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "start": { "type": "integer" },
            "end": { "type": "integer" },
            "sequence": { "type": "string" },
            "matureSequence": { "type": "string" },
            "starSequence": { "type": "string" },
            "structure": { "type": "string", "description": "Dot-bracket secondary structure" },
            "freeEnergy": { "type": "number", "description": "Turner 2004 nearest-neighbor free energy" }
          },
          "required": ["start", "end", "sequence", "matureSequence", "starSequence", "structure", "freeEnergy"]
        }
      }
    },
    "required": ["hairpins"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" },
    { "code": 1001, "message": "minMfei must be a finite value >= 0" }
  ],
  "examples": [
    {
      "name": "57 nt hairpin (min 55) yields six candidate windows",
      "input": { "sequence": "GCAUAGCUAGCUAGCUAGCUAGCUAGAAAUUUUAGCUAGCUAGCUAGCUAGCUAUGC", "minHairpinLength": 55 },
      "output": { "hairpins": [ { "start": 0, "end": 54 }, { "start": 0, "end": 55 }, { "start": 0, "end": 56 }, { "start": 1, "end": 55 }, { "start": 1, "end": 56 }, { "start": 2, "end": 56 } ] }
    },
    {
      "name": "Below minimum length",
      "input": { "sequence": "GCAUAGCUAGCUAGCUAGCUGAAAUUUAGCUAGCUAGCUAGCUAUGC", "minHairpinLength": 55 },
      "output": { "hairpins": [] }
    }
  ]
}
