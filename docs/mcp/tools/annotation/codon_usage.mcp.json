{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "codon_usage",
  "serverName": "Annotation",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "GenomeAnnotator.GetCodonUsage",
  "docRef": "Seqeron.Genomics.Annotation/GenomeAnnotator.cs#L1863",
  "description": "Count codon occurrences (in-frame from position 0, non-overlapping, 5'->3') for a coding sequence. DNA or RNA, case-insensitive: U is read as T and keys are upper-case DNA codons; a triplet with any other symbol (N, IUPAC code, gap) is skipped without shifting the frame; a partial trailing codon is ignored (CodonW / EMBOSS cusp convention).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "dnaSequence": { "type": "string", "description": "Coding DNA or RNA sequence (length should be a multiple of 3)", "minLength": 1 }
    },
    "required": ["dnaSequence"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "usage": { "type": "object", "description": "Codon -> occurrence count", "additionalProperties": { "type": "integer" } }
    },
    "required": ["usage"]
  },
  "errors": [
    { "code": 1001, "message": "Sequence cannot be null or empty" }
  ],
  "examples": [
    {
      "name": "Repeated start codon",
      "input": { "dnaSequence": "ATGATGAAATAA" },
      "output": { "usage": { "ATG": 2, "AAA": 1, "TAA": 1 } }
    },
    {
      "name": "Partial trailing codon ignored",
      "input": { "dnaSequence": "ATGAT" },
      "output": { "usage": { "ATG": 1 } }
    },
    {
      "name": "RNA input, ambiguous triplet skipped",
      "input": { "dnaSequence": "AUGNNNAAA" },
      "output": { "usage": { "ATG": 1, "AAA": 1 } }
    }
  ]
}
