{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "suffix_tree_find_mems",
  "serverName": "Core",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SuffixTree.FindMaximalExactMatches",
  "docRef": "SuffixTree/SuffixTree.Algorithms.cs#L205",
  "description": "Find all maximal exact matches (MEMs) of length >= minLength between a reference text and a query (MUMmer 3 'mummer -maxmatch', forward strand), 0-based, sorted by query then text position.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "The reference text (the suffix tree is built on it)",
        "minLength": 1
      },
      "query": {
        "type": "string",
        "description": "The query string matched against the reference",
        "minLength": 1
      },
      "minLength": {
        "type": "integer",
        "description": "Minimum match length (>= 1; MUMmer default 20)",
        "minimum": 1,
        "default": 20
      }
    },
    "required": [
      "text",
      "query"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "matches": {
        "type": "array",
        "description": "Matches sorted by query position, then text position",
        "items": {
          "type": "object",
          "properties": {
            "positionInText": {
              "type": "integer"
            },
            "positionInQuery": {
              "type": "integer"
            },
            "length": {
              "type": "integer"
            }
          },
          "required": [
            "positionInText",
            "positionInQuery",
            "length"
          ]
        }
      }
    },
    "required": [
      "matches"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Text cannot be null or empty"
    },
    {
      "code": 1002,
      "message": "Query cannot be null or empty"
    },
    {
      "code": 1003,
      "message": "minLength must be >= 1"
    }
  ],
  "examples": [
    {
      "name": "MUMmer -maxmatch -l 3",
      "input": {
        "text": "GATTACAGATTACA",
        "query": "ATTACAGGATTACAT",
        "minLength": 3
      },
      "output": {
        "matches": [
          {
            "positionInText": 1,
            "positionInQuery": 0,
            "length": 7
          },
          {
            "positionInText": 8,
            "positionInQuery": 0,
            "length": 6
          },
          {
            "positionInText": 0,
            "positionInQuery": 7,
            "length": 7
          },
          {
            "positionInText": 7,
            "positionInQuery": 7,
            "length": 7
          }
        ]
      }
    }
  ]
}
