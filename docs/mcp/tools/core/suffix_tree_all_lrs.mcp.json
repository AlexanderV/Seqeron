{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "suffix_tree_all_lrs",
  "serverName": "Core",
  "version": "1.0.0",
  "stability": "stable",
  "methodId": "SuffixTree.FindAllLongestRepeatedSubstrings",
  "docRef": "SuffixTree/SuffixTree.Algorithms.cs#L67",
  "description": "Find every distinct longest repeated substring of text (all length ties), each with all 0-based start positions ascending; ordered by first occurrence.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "The text to analyze",
        "minLength": 1
      }
    },
    "required": [
      "text"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "substrings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "substring": {
              "type": "string"
            },
            "positions": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          "required": [
            "substring",
            "positions"
          ]
        }
      },
      "length": {
        "type": "integer",
        "description": "Common length (0 when none)"
      }
    },
    "required": [
      "substrings",
      "length"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Text cannot be null or empty"
    }
  ],
  "examples": [
    {
      "name": "Three tied repeats",
      "input": {
        "text": "abcxbcaxcab"
      },
      "output": {
        "substrings": [
          {
            "substring": "ab",
            "positions": [
              0,
              9
            ]
          },
          {
            "substring": "bc",
            "positions": [
              1,
              4
            ]
          },
          {
            "substring": "ca",
            "positions": [
              5,
              8
            ]
          }
        ],
        "length": 2
      }
    },
    {
      "name": "Single repeat",
      "input": {
        "text": "banana"
      },
      "output": {
        "substrings": [
          {
            "substring": "ana",
            "positions": [
              1,
              3
            ]
          }
        ],
        "length": 3
      }
    }
  ]
}
