{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "toolName": "compare_assemblies",
  "serverName": "Chromosome",
  "version": "1.1.0",
  "stability": "stable",
  "methodId": "GenomeAssemblyAnalyzer.CompareAssemblies",
  "docRef": "Seqeron.Genomics.Chromosome/GenomeAssemblyAnalyzer.cs#L842",
  "description": "Compare two assemblies by exact canonical k-mer sets (Mash model): shared/distinct k-mers, containment, Jaccard index and Mash distance.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "assembly1": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "sequence": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "sequence"
          ]
        }
      },
      "assembly2": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "sequence": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "sequence"
          ]
        }
      },
      "name1": {
        "type": "string",
        "default": "Assembly1"
      },
      "name2": {
        "type": "string",
        "default": "Assembly2"
      },
      "kmerSize": {
        "type": "integer",
        "default": 21,
        "exclusiveMinimum": 0
      }
    },
    "required": [
      "assembly1",
      "assembly2"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "assembly1Name": {
        "type": "string"
      },
      "assembly2Name": {
        "type": "string"
      },
      "kmerSize": {
        "type": "integer"
      },
      "distinctKmers1": {
        "type": "integer"
      },
      "distinctKmers2": {
        "type": "integer"
      },
      "sharedKmers": {
        "type": "integer"
      },
      "containment1": {
        "type": "number"
      },
      "containment2": {
        "type": "number"
      },
      "jaccardIndex": {
        "type": "number"
      },
      "mashDistance": {
        "type": "number"
      }
    },
    "required": [
      "assembly1Name",
      "assembly2Name",
      "kmerSize",
      "distinctKmers1",
      "distinctKmers2",
      "sharedKmers",
      "containment1",
      "containment2",
      "jaccardIndex",
      "mashDistance"
    ]
  },
  "errors": [
    {
      "code": 1001,
      "message": "Assembly 1 cannot be null"
    },
    {
      "code": 1002,
      "message": "Assembly 2 cannot be null"
    },
    {
      "code": 1003,
      "message": "K-mer size must be positive"
    }
  ],
  "examples": [
    {
      "name": "Identical assemblies",
      "input": {
        "assembly1": [
          {
            "id": "s",
            "sequence": "ACGT…"
          }
        ],
        "assembly2": [
          {
            "id": "s",
            "sequence": "ACGT…"
          }
        ],
        "name1": "A",
        "name2": "B",
        "kmerSize": 21
      },
      "output": {
        "assembly1Name": "A",
        "assembly2Name": "B",
        "containment1": 1.0,
        "containment2": 1.0,
        "jaccardIndex": 1.0,
        "mashDistance": 0.0
      }
    }
  ]
}