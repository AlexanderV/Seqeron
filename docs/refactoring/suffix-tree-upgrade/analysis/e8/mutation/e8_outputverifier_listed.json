 },
 {
  "id": "C10",
  "desc": "a cap of 0 means a limit of 0",
  "old": "long lim = cap > 0 ? Math.Min(maxLen, cap) : maxLen;",
  "new": "long lim = cap >= 0 ? Math.Min(maxLen, cap) : maxLen;",
  "file": "apps/SuffixTree.EmProto/Verify/OutputVerifier.cs"
 },
 {
  "id": "C11",
  "desc": "a pair where one suffix ends is treated as a long pair",
  "old": "if (l < lim || lim == maxLen)",
