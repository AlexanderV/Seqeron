  "new": "bool scaled = o.ScaleN >= 0;"
 },
 {
  "id": "S12",
  "desc": "the PH1 fan-out default is 64",
  "old": "t.DcsFanOut ?? 1024",
  "new": "t.DcsFanOut ?? 64"
 },
 {
  "id": "S13",
  "desc": "the PH3 fan-out default is 16",
  "old": "FanOut = t.FanOut ?? 64,",
  "new": "FanOut = t.FanOut ?? 16,"
 },
 {
  "id": "S14",
  "desc": "the stack block default is 64 K entries",
  "old": "t.BlockEntries ?? 256 * 1024",
  "new": "t.BlockEntries ?? 64 * 1024"
 },
 {
  "id": "S15",
