[
 {
  "id": "S01",
  "desc": "the references are truncated instead of rounded",
  "old": "Math.Max(floor, (long)Math.Round(reference * f))",
  "new": "Math.Max(floor, (long)(reference * f))"
 },
 {
  "id": "S02",
  "desc": "the factor is n / (ScaleN + 1)",
  "old": "double f = scaled ? n / (double)o.ScaleN : 1.0;",
  "new": "double f = scaled ? n / (double)(o.ScaleN + 1) : 1.0;"
 },
 {
  "id": "S03",
  "desc": "R of PH4 is rounded down",
  "old": "(long)Math.Ceiling(E4.ChunkRef * f)",
  "new": "(long)Math.Floor(E4.ChunkRef * f)"
 },
 {
  "id": "S04",
  "desc": "the reference K of PH3 is 2^20",
  "old": "(long)((decimal)n * BucketReference / o.ScaleN)",
  "new": "(long)((decimal)n * BucketUnscaled / o.ScaleN)"
 },
 {
  "id": "S05",
  "desc": "K has a floor of one",
  "old": "Math.Max(2, t.BucketCapacity",
  "new": "Math.Max(1, t.BucketCapacity"
 },
 {
  "id": "S06",
  "desc": "the B2 workers are not limited by the threads",
  "old": "Math.Clamp(o.ArenaCapBytes / Math.Max(1, perTask), 1, o.Threads)",
  "new": "Math.Clamp(o.ArenaCapBytes / Math.Max(1, perTask), 1, 64)"
 },
 {
  "id": "S07",
  "desc": "the B2 workers are computed from the arena cap of PH5",
  "old": "Math.Clamp(o.ArenaCapBytes / Math.Max(1, perTask), 1, o.Threads)",
  "new": "Math.Clamp(o.ChildArenaCapBytes / Math.Max(1, perTask), 1, o.Threads)"
 },
 {
  "id": "S08",
  "desc": "an explicit R of PH4 is ignored",
  "old": "long chunk = t.LcpChunk ?? (scaled",
  "new": "long chunk = (scaled"
 },
 {
  "id": "S09",
  "desc": "the run spill has a floor of 3",
  "old": "Scale(RunSpillReference, 0)",
  "new": "Scale(RunSpillReference, 3)"
 },
 {
  "id": "S10",
  "desc": "N_base has no floor of 4",
  "old": "Math.Max(4, t.DcsBaseCase ?? Scale(E3b.BaseRef, 4))",
