[
 {
  "id": "W01",
  "desc": "a window that is not a power of two is accepted",
  "old": "windowBytes < 4 || !BitOperations.IsPow2(windowBytes)",
  "new": "windowBytes < 4"
 },
 {
  "id": "W02",
  "desc": "the bound of Write32 is one entry too wide",
  "old": "(ulong)index >= (ulong)(Length >> 2)",
  "new": "(ulong)index > (ulong)(Length >> 2)"
 },
 {
  "id": "W03",
  "desc": "the window that is released is the most recently used",
  "old": "_slots[i].LastUse < oldest",
  "new": "_slots[i].LastUse > oldest"
 },
 {
  "id": "W04",
  "desc": "a window is flushed also when flushing is off",
