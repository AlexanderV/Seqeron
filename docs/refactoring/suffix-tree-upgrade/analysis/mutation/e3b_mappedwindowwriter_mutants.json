  "new": "long size = _window;"
 },
 {
  "id": "W03",
  "desc": "Append: position not advanced",
  "old": "_next += data.Length;",
  "new": "_next += 0;"
 },
 {
  "id": "W04",
  "desc": "WriteAt: the last byte of the file cannot be written",
  "old": "offset + data.Length > Length)",
  "new": "offset + data.Length >= Length)"
 },
