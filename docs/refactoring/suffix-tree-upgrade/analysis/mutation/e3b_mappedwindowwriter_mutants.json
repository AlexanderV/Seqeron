[
 {
  "id": "W01",
  "desc": "WriteAt: a write at the end of the window does not open the next one (loops for ever)",
  "old": "offset < _viewStart || offset >= _viewEnd",
  "new": "offset < _viewStart || offset > _viewEnd"
 },
 {
  "id": "W02",
  "desc": "OpenWindow: window not clipped to the file end",
