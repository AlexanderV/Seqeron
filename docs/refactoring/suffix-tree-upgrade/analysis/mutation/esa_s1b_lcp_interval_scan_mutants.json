[
 {
  "id": "S01",
  "desc": "pop condition >= instead of > (an interval of equal value is closed too)",
  "old": "while (sp > 0 && ell[sp - 1] > cur)",
  "new": "while (sp > 0 && ell[sp - 1] >= cur)"
 },
 {
  "id": "S02",
  "desc": "lastChild: <= instead of < (a middle child is reported as the last one)",
  "old": "sp == 0 || cur < ell[sp - 1]",
  "new": "sp == 0 || cur <= ell[sp - 1]"
 },
 {
  "id": "S03",
  "desc": "the left boundary of a new interval ignores the popped children",
  "old": "                left = b;\n",
  "new": "                left = i - 1;\n"
 },
