<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The in-memory build, entry and Open measurements of work package 1b.9 (see README.md). Outside the shipped code and not part of Seqeron.sln. The assembly carries the name of the Esa bench app because
    SuffixTree.Esa lets that name see its internals; the build under test comes from EsaDir (a directory with SuffixTree.Esa.dll, SuffixTree.Core.dll and SuffixTree.Persistent.dll):
      dotnet build SuffixTree.Esa/SuffixTree.Esa.csproj -c Release -o <esa dir>
      dotnet build Gate1b9.csproj -c Release -p:EsaDir=<esa dir> -o <out dir>
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SuffixTree.Esa.Bench</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SuffixTree.Core"><HintPath>$(EsaDir)/SuffixTree.Core.dll</HintPath></Reference>
    <Reference Include="SuffixTree.Esa"><HintPath>$(EsaDir)/SuffixTree.Esa.dll</HintPath></Reference>
    <Reference Include="SuffixTree.Persistent"><HintPath>$(EsaDir)/SuffixTree.Persistent.dll</HintPath></Reference>
  </ItemGroup>

</Project>
