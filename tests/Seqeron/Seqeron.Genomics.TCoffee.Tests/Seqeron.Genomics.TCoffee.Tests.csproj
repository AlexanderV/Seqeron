    <EmbeddedResource Include="..\Seqeron.Genomics.ClustalW.Tests\TestData\Alignment\clustalw_protein_quick_oracle.tsv" LogicalName="Seqeron.Genomics.Tests.TestData.Alignment.clustalw_protein_quick_oracle.tsv" />
    <EmbeddedResource Include="..\Seqeron.Genomics.ClustalW.Tests\TestData\Alignment\msa_matrix_clustalw_oracle.tsv" LogicalName="Seqeron.Genomics.Tests.TestData.Alignment.msa_matrix_clustalw_oracle.tsv" />
    <EmbeddedResource Include="..\Seqeron.Genomics.Tests\TestData\Alignment\msa_affine_exact_oracle.tsv" LogicalName="Seqeron.Genomics.Tests.TestData.Alignment.msa_affine_exact_oracle.tsv" />
