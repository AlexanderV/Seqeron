<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests (and oracle data) of the copyleft assembly Seqeron.Genomics.Emboss.Repeats. The tests ship under the licence of that assembly (see its LICENSE). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- same root namespace as Seqeron.Genomics.Tests: the embedded resource names (Seqeron.Genomics.Tests.TestData.*) and the test namespaces stay unchanged -->
    <RootNamespace>Seqeron.Genomics.Tests</RootNamespace>
    <AssemblyName>Seqeron.Genomics.Emboss.Repeats.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Seqeron.Genomics.Tests\TestDataResource.cs" Link="TestDataResource.cs" />
    <Compile Include="..\Seqeron.Genomics.Tests\_LimitationPolicyTestBootstrap.cs" Link="_LimitationPolicyTestBootstrap.cs" />
    <Compile Include="..\Seqeron.Genomics.Tests\Parallelization.cs" Link="Parallelization.cs" />
    <Compile Include="..\Seqeron.Genomics.Tests\Helpers\OracleEscapes.cs" Link="Helpers\OracleEscapes.cs" />
    <Compile Include="..\Seqeron.Genomics.Tests\Unit\Alignment\PollCancellation.cs" Link="Unit\Alignment\PollCancellation.cs" />
    <Compile Include="..\Seqeron.Genomics.Emboss.SequenceFormats.Tests\Unit\Alignment\EmbossReferenceDp.cs" Link="Unit\Alignment\EmbossReferenceDp.cs" />
    <Compile Include="..\Seqeron.Genomics.Emboss.SequenceFormats.Tests\Unit\Alignment\EmbossSeqOptsProducer.cs" Link="Unit\Alignment\EmbossSeqOptsProducer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Seqeron.Genomics.Core" />
    <Using Include="Seqeron.Genomics.Infrastructure" />
    <Using Include="Seqeron.Genomics.IO" />
    <Using Include="Seqeron.Genomics.Alignment" />
    <Using Include="Seqeron.Genomics.Analysis" />
    <Using Include="Seqeron.Genomics.Emboss.SequenceFormats" />
    <Using Include="Seqeron.Genomics.Emboss.FeatureTools" />
    <Using Include="Seqeron.Genomics.Emboss.Repeats" />
    <Using Include="Seqeron.Genomics.Emboss.PairwiseAlignment" />
    <Using Include="Seqeron.Genomics.Emboss.Motifs" />
    <Using Include="Seqeron.Genomics.Emboss.OpenReadingFrames" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Seqeron.Genomics.Tests\TestData\Alignment\option_boundary_oracle.json" Link="TestData\Alignment\option_boundary_oracle.json" />
    <EmbeddedResource Include="TestData\Alignment\wordmatch_oracle.jsonl.gz" />
    <!-- A5-8c3d (B09 F225): wordmatch with the feature output qualifiers (-offormat4/5 ...) of both feature files; scripts/alignment/generate_wordmatch_featout_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\wordmatch_featout_oracle.jsonl.gz" />
    <!-- A5-8c3e (B09 F239): wordmatch with the sequence qualifiers of both inputs; scripts/alignment/generate_wordmatch_seqopts_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\wordmatch_seqopts_oracle.jsonl.gz" />
    <!-- GENOMIC-TANDEM-001 (B09 A3-8): EMBOSS etandem / equicktandem 6.6.0 original-format output on random and planted sequences (1700 + 1300 rows);
         scripts/analysis/generate_emboss_tandem_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\emboss_tandem_oracle.tsv" />
    <!-- GENOMIC-COMMON-001 / GENOMIC-REPEAT-001 / ALIGN-SEMI-001 (B09 A3-13): EMBOSS seqmatchall (330 sets), palindrome -gaplimit 0 (330 sequences) and merger (450 read pairs) 6.6.0;
         scripts/analysis/generate_seqmatchall_oracle.py, generate_palindrome_gap0_oracle.py, scripts/alignment/generate_merger_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\seqmatchall_oracle.tsv.gz" />
    <EmbeddedResource Include="TestData\Analysis\palindrome_gap0_oracle.tsv" />
    <EmbeddedResource Include="..\Seqeron.Genomics.Tests\TestData\Analysis\tandem_oracle.tsv" Link="TestData\Analysis\tandem_oracle.tsv" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics\Seqeron.Genomics.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Infrastructure\Seqeron.Genomics.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Core\Seqeron.Genomics.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.IO\Seqeron.Genomics.IO.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Alignment\Seqeron.Genomics.Alignment.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Analysis\Seqeron.Genomics.Analysis.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Emboss.SequenceFormats\Seqeron.Genomics.Emboss.SequenceFormats.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Emboss.FeatureTools\Seqeron.Genomics.Emboss.FeatureTools.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Emboss.Repeats\Seqeron.Genomics.Emboss.Repeats.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Emboss.PairwiseAlignment\Seqeron.Genomics.Emboss.PairwiseAlignment.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Emboss.Motifs\Seqeron.Genomics.Emboss.Motifs.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.Emboss.OpenReadingFrames\Seqeron.Genomics.Emboss.OpenReadingFrames.csproj" />
    <ProjectReference Include="..\..\..\src\Seqeron\Algorithms\Seqeron.Genomics.TCoffee\Seqeron.Genomics.TCoffee.csproj" />
  </ItemGroup>

</Project>
