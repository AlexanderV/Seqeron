    <!-- A4-3 (B09 F153): the EMBOSS programs 6.6.0 on plain sequences that contain gap characters and other non-letters (the reader drops them); scripts/alignment/generate_emboss_gap_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\emboss_gap_oracle.tsv" />
    <EmbeddedResource Include="TestData\Alignment\supermatcher_wordlen_oracle.tsv" />
    <EmbeddedResource Include="TestData\Alignment\matcher_gap_oracle.tsv" />
    <!-- ALIGN-STATS-001 (audit A2-15, B09 F90): EMBOSS 6.6.0 distmat, every correction and option (1 100 sets); scripts/alignment/generate_distmat_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\distmat_oracle.tsv" />
    <!-- ALIGN-MULTI-001 (audit A2-27, B09 F120): EMBOSS 6.6.0 -aformat output formats (needle / water) and the sequence-set formats (seqret), byte for byte;
         scripts/alignment/generate_emboss_aformat_oracle.py, scripts/alignment/generate_emboss_seqout_oracle.py (faked run dates: scripts/alignment/faketime.c). -->
    <EmbeddedResource Include="TestData\Alignment\emboss_aformat_oracle.tsv.gz" />
    <EmbeddedResource Include="TestData\Alignment\emboss_seqout_oracle.tsv.gz" />
    <!-- ALIGN-GLOBAL-001 (audit A2-28, B09 F122): EMBOSS 6.6.0 needle with -endweight / -endopen / -endextend; scripts/alignment/generate_needle_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\needle_oracle.tsv" />
    <!-- ALIGN-LOCAL-001 / ALIGN-GLOBAL-001 (audit A2-28c, B09 F124): EMBOSS supermatcher and needleall whole output files; scripts/alignment/generate_emboss_multi_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\emboss_multi_oracle.tsv.gz" />
    <!-- ALIGN-STATS-001 (audit A3-13c, B09 F148): EMBOSS showalign 6.6.0 text output of random alignments with random options (600 cases, JSON lines);
         scripts/analysis/generate_showalign_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\showalign_oracle.jsonl" />
    <!-- ALIGN-STATS-001 (audit A4-9): 400 showalign rows with -sbegin / -send; scripts/analysis/generate_showalign_range_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\showalign_range_oracle.jsonl" />
    <EmbeddedResource Include="TestData\Analysis\showalign_html_oracle.jsonl" />
    <!-- GENOMIC-COMMON-001 (audit A3-13b, B09 F149): EMBOSS megamerger 6.6.0 merged sequence + report of 600 related / unrelated DNA pairs (JSON lines);
         scripts/analysis/generate_megamerger_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\megamerger_oracle.jsonl" />
    <!-- GENOMIC-COMMON-001 (audit A4-9): 480 edge rows of megamerger (lower-case-only sequences, N runs longer than the word, sequences shorter than the word / identical / nested);
         scripts/analysis/generate_megamerger_edge_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\megamerger_edge_oracle.jsonl" />
    <EmbeddedResource Include="TestData\Alignment\merger_oracle.tsv" />
  </ItemGroup>

