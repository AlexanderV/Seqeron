    <!-- ALIGN-LOCAL-001 (audit A2-28d, B09 F145): EMBOSS matcher 6.6.0 (Huang-Miller SIM) alignment lists in the program's own tie order; scripts/alignment/generate_matcher_sim_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\matcher_sim_oracle.tsv" />
    <!-- ALIGN-LOCAL-001 (audit A2-28d, B09 F152): EMBOSS dotmatcher 6.6.0 plot segments of 600 DNA / protein pairs (graph data); scripts/alignment/generate_dotmatcher_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\dotmatcher_oracle.tsv" />
    <!-- ALIGN-LOCAL-001 (audit A4-9): 720 edge rows of dotmatcher (lower case, ambiguity codes, *, gap characters, default matrix, window >= length); scripts/alignment/generate_dotmatcher_edge_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\dotmatcher_edge_oracle.tsv" />
    <EmbeddedResource Include="TestData\Alignment\distmat_file_oracle.jsonl.gz" />
    <EmbeddedResource Include="TestData\Alignment\diffseq_oracle.jsonl.gz" />
    <EmbeddedResource Include="TestData\Alignment\est2genome_oracle.jsonl.gz" />
    <EmbeddedResource Include="TestData\Alignment\diffseq_qualifiers_oracle.jsonl.gz" />
