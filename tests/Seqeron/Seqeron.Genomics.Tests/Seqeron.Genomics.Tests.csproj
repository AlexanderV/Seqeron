<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azimuth / Rule Set 2 oracle vectors generated by scripts/azimuth/extract_azimuth_model.py
         (this project's verified Python reference). Embedded so the suite is self-contained. -->
    <EmbeddedResource Include="TestData\Azimuth\nopos_oracle.csv" />
    <EmbeddedResource Include="TestData\Azimuth\full_oracle.csv" />
    <!-- RESTR-FIND-001 (B08 D4/F59): Biopython 1.88 search() oracle for all 754 vendored REBASE enzymes,
         linear and circular; generated by scripts/rebase/generate_rebase_enzymes.py oracle. -->
    <EmbeddedResource Include="TestData\Restriction\biopython_rebase_search.tsv" />
    <!-- ALIGN-STATS-001 (B09 F11-F14): EMBOSS needle/water 6.6.0 statistics + markup and Biopython 1.88
         Alignment.counts for 301 alignments; generated by scripts/alignment/generate_alignment_stats_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\needle_water_stats.tsv" />
    <!-- ALIGN-GLOBAL/LOCAL/SEMI (audit A1-2, B09 F41): substitution-matrix pairwise alignment scores with fractional gap
         scores: Biopython 1.88 PairwiseAligner, EMBOSS needle/water 6.6.0, parasail 1.3.4;
         scripts/alignment/generate_matrix_align_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\matrix_align_oracle.tsv" />
    <!-- ALIGN-SEMI-001 (audit A1-3, B09 F44): ends-free alignment, 16 end-gap policies; Biopython 1.88 / parasail 1.3.4 / EMBOSS needle default; scripts/alignment/generate_endgaps_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\endgaps_oracle.tsv" />
    <!-- ALIGN-GLOBAL/LOCAL/SEMI-001 (audit A1-5, B09 F45): general (Waterman-Smith-Beyer) gap-cost functions; Biopython 1.88 PairwiseAligner(gap_score=callable) + independent reference; scripts/alignment/generate_general_gap_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\general_gap_oracle.tsv" />
    <!-- ALIGN-LOCAL-001 (audit A1-7, B09 F47): Waterman-Eggert non-intersecting local alignments + co-optimal local alignments; independent full-recompute Waterman-Eggert reference,
         exhaustive brute force on tiny inputs, EMBOSS matcher 6.6.0 (verified round by round against the definition), Biopython 1.88 co-optimal set; scripts/alignment/generate_topn_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\topn_oracle.tsv" />
    <!-- ALIGN-GLOBAL/LOCAL/SEMI-001 (audit A1-6, B09 F46): exact linear-space alignment; Biopython 1.88 / parasail 1.3.4 scores and co-optimal rows, EMBOSS stretcher 6.6.0
         (Myers-Miller) and matcher 6.6.0 (Huang-Miller SIM); scripts/alignment/generate_linear_space_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\linear_space_oracle.tsv" />
    <!-- ALIGN-STATS-001 (audit A1-9, B09 F42): NCBI BLAST+ 2.12.0 blastn/blastp tabular counts + pairwise-report integer percentages
         for 320 HSPs; scripts/alignment/generate_blast_stats_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\blast_stats_oracle.tsv" />
    <!-- ALIGN-STATS-001 (audit A1-9, B09 F43): EMBOSS infoalign/distmat 6.6.0, ClustalW 2.1 conservation line and Biopython 1.88
         DistanceCalculator('identity') on random multiple alignments; scripts/alignment/generate_msa_stats_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\msa_stats_oracle.tsv" />
    <!-- ALIGN-MULTI-001 (audit A1-15, B09 F51): ClustalW 2.1 pairwise stage (`clustalw -ALIGN` "Score:" = truncated percent identity)
         on 3 600 DNA/IUPAC pairs and the progressive / iterative MSA driven by it (independent Python);
         scripts/alignment/generate_clustalw_pairwise_oracle.py. -->
    <EmbeddedResource Include="TestData\Alignment\clustalw_pairwise_oracle.tsv" />
    <EmbeddedResource Include="TestData\Alignment\clustalw_msa_oracle.tsv" />
