    <EmbeddedResource Include="TestData\Analysis\common_region_oracle.tsv" />
    <!-- GENOMIC-MOTIFS-001 (B09 F18-F20): EMBOSS fuzznuc 6.6.0 (== independent Python regex) forward / reverse-strand,
         exact and IUPAC known-motif hits for 2448 (sequence, pattern) pairs; scripts/analysis/generate_known_motif_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\known_motif_oracle.tsv" />
    <!-- GENOMIC-MOTIFS-001 (B09 A1-20): mismatch-tolerant known-motif hits, EMBOSS fuzznuc 6.6.0 pmismatch 1..3 (positions + mismatch notes)
         == independent Python Hamming scan, 6576 (sequence, pattern, k) rows; scripts/analysis/generate_known_motif_oracle.py (mismatch mode). -->
    <EmbeddedResource Include="TestData\Analysis\known_motif_mismatch_oracle.tsv" />
    <!-- GENOMIC-SIMILARITY-001 (B09 F32-F34): exact k-mer Jaccard (percent), literal == Python set == scipy jaccard on presence
         vectors, canonical == Python set over min(w, revcomp w) == sourmash 4.9.4 MinHash(scaled=1); 2086 rows;
         scripts/analysis/generate_similarity_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\similarity_oracle.tsv" />
    <!-- GENOMIC-REPEAT-001 (B09 F28-F30): independent Python (brute force + suffix array/Kasai LCP) oracle for repeated
         substrings, Gusfield maximal repeats and all longest repeats; scripts/analysis/generate_repeat_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\repeat_oracle.tsv" />
    <!-- GENOMIC-TANDEM-001 (B09 F35-F38): exact tandem repeats = maximal repetitions (runs) with a primitive unit; 1156
         (sequence, minUnit, minReps, maxUnit) rows, three independent Python methods asserted equal (Kolpakov-Kucherov
         runs by brute force, boolean-array runs, regex); scripts/analysis/generate_tandem_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\tandem_oracle.tsv" />
    <!-- GENOMIC-REPEAT-001 (B09 F27): Biopython reverse-complement palindrome windows (Rosalind REVP definition);
         scripts/analysis/generate_palindrome_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\palindrome_oracle.tsv" />
    <!-- GENOMIC-ORF-001 (B09 F21-F26): independent Biopython finder == NCBI COrf::FindOrfs port == EMBOSS getorf 6.6.0
         (longest-per-stop configuration), 1746 (sequence, options) rows; scripts/analysis/generate_orf_oracle.py. -->
    <EmbeddedResource Include="TestData\Analysis\orf_oracle.tsv" />
    <!-- GENOMIC-TANDEM / GENOMIC-REPEAT / GENOMIC-ORF-001 (B09 A1-21): the same oracle generators in ambiguous mode, sequences with N and other
         IUPAC symbols for the string overloads of FindTandemRepeats / FindPalindromes / FindOpenReadingFrames. -->
    <EmbeddedResource Include="TestData\Analysis\tandem_iupac_oracle.tsv" />
    <EmbeddedResource Include="TestData\Analysis\palindrome_iupac_oracle.tsv" />
    <EmbeddedResource Include="TestData\Analysis\orf_ambiguous_oracle.tsv" />
    <EmbeddedResource Include="TestData\Restriction\emboss_restrict_bothstrand.tsv" />
