<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azimuth / Rule Set 2 oracle vectors generated by scripts/azimuth/extract_azimuth_model.py
         (this project's verified Python reference). Embedded so the suite is self-contained. -->
    <EmbeddedResource Include="TestData\Azimuth\nopos_oracle.csv" />
    <EmbeddedResource Include="TestData\Azimuth\full_oracle.csv" />
    <!-- ONCO-MHC-001: one MHCflurry models_class1_pan affinity network (smallest member, feedforward
         [512,512]), exported from the Apache-2.0 weights_*.npz dense kernels/biases. Embedded so the
         forward-pass parity test runs without an external mhcflurry install. -->
    <EmbeddedResource Include="TestData\Mhcflurry\mhcflurry_single_net.bin" />
    <!-- MHC-NN-001: a tiny synthetic "with-skip-connections" network pack (3 hidden + output, deterministic
         weights) used to exercise the densenet skip-connection forward-pass wiring that the feedforward
         single_net pack does not cover. Golden raw output computed by an independent NumPy reference. -->
    <EmbeddedResource Include="TestData\Mhcflurry\mhcflurry_skip_net.bin" />
    <!-- TRANS-CODON-001: Biopython 1.88 Bio.Seq.translate / Bio.Data.CodonTable.ambiguous_dna_by_id over all
         15^3 IUPAC codons for every NCBI translation table (gc.prt v4.6 == Biopython tables). -->
    <EmbeddedResource Include="TestData\GeneticCode\biopython_ambiguous_codons.tsv" />
    <!-- ONCO-SIG-002: COSMIC v3.4 SBS96 reference signatures (86 × 96), verbatim from SigProfilerAssignment
         (SigProfilerAssignment/data/Reference_Signatures/GRCh37/COSMIC_v3.4_SBS_GRCh37.txt). Used to cross-check
         FitSignatures (NNLS refit to the full COSMIC set) against scipy.optimize.nnls. -->
    <EmbeddedResource Include="TestData\Cosmic\COSMIC_v3.4_SBS_GRCh37.txt" />
    <!-- SEQ-REPLICATION-001: Rosalind BA1F ("Minimum Skew Problem") extra dataset (93 523 bp genome +
         published answer "89969 89970 89971 90345 90346"), verbatim from the mirror
         raw.githubusercontent.com/charlesreid1/go-rosalind/master/rosalind/data/minimum_skew.txt. -->
    <EmbeddedResource Include="TestData\Rosalind\ba1f_extra_dataset.txt" />
    <!-- ONCO-PURITY-001 (FIN-B24 F33/F34): seeded synthetic clonal SNV sets (VAF, Major, minor, NV, DP) simulated in R
         (set.seed 20261009/10/11; NV ~ Binom(DP, m·π/(2(1−π)+π(M+m)))) and run through CNAqc 1.1.5 analyze_peaks_common
         (caravagnalab/CNAqc 4b7cea4a); generator: docs/Evidence/ONCO-PURITY-001-Evidence.md "CNAqc analyze_peaks — peak-based purity QC" pt 7. -->
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_D1.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_D3.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_D4.tsv" />
    <!-- ONCO-PURITY-001 (FIN-B24 F62): seeded complex-karyotype sets G1–G3 (set.seed 20261020/21/22) and subclonal segment
         sets S1–S3 (segments + mutations simulated from CNAqc expectations_subclonal peaks), with the CNAqc 1.1.5
         analyze_peaks_general / analyze_peaks_subclonal R outputs (cnaqc_general_R.txt, cnaqc_subclonal_R.txt);
         generator: docs/Evidence/ONCO-PURITY-001-Evidence.md "CNAqc analyze_peaks_general / analyze_peaks_subclonal". -->
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_G1.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_G2.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_G3.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_S1_segments.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_S1_mutations.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_S2_segments.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_S2_mutations.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_S3_segments.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_S3_mutations.tsv" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_general_R.txt" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_subclonal_R.txt" />
    <!-- ONCO-PURITY-001 (FIN-B24 F63): BMix bmixfit grids (R matprod default + internal), CNAqc analyze_peaks_common with
         BMix and n_bootstrap, analyze_peaks_general / _subclonal with n_bootstrap (set.seed per run); generator:
         docs/Evidence/ONCO-PURITY-001-Evidence.md "BMix and n_bootstrap". -->
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_bmix_R.txt" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_common_boot_R.txt" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_general_boot_R.txt" />
    <EmbeddedResource Include="TestData\CNAqc\cnaqc_subclonal_boot_R.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Tier 1: Fluent assertions with better failure messages -->
    <PackageReference Include="FluentAssertions" />
    <!-- Tier 2: Property-based testing for mathematical invariants -->
    <PackageReference Include="FsCheck" />
    <PackageReference Include="FsCheck.NUnit" />
    <!-- Tier 2: Snapshot/approval testing for complex outputs -->
    <PackageReference Include="Verify.NUnit" />
    <!-- Tier 3: Architecture guard tests -->
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Seqeron.Genomics.Core" />
    <Using Include="Seqeron.Genomics.Infrastructure" />
    <Using Include="Seqeron.Genomics.IO" />
    <Using Include="Seqeron.Genomics.Alignment" />
    <Using Include="Seqeron.Genomics.Analysis" />
    <Using Include="Seqeron.Genomics.Annotation" />
    <Using Include="Seqeron.Genomics.Phylogenetics" />
    <Using Include="Seqeron.Genomics.Population" />
    <Using Include="Seqeron.Genomics.Metagenomics" />
    <Using Include="Seqeron.Genomics.MolTools" />
    <Using Include="Seqeron.Genomics.Chromosome" />
    <Using Include="Seqeron.Genomics.Reports" />
    <Using Include="Seqeron.Genomics.Oncology" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

